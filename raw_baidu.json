{"code": 200, "name": "baidu", "title": "百度", "type": "热搜", "params": {"type": {"name": "热搜类别", "type": {"realtime": "热搜", "novel": "小说", "movie": "电影", "teleplay": "电视剧", "car": "汽车", "game": "游戏"}}}, "link": "https://top.baidu.com/board", "total": 30, "fromCache": false, "updateTime": "2026-10-13T00:32:44.228Z", "data": [{"id": 0, "title": "习近平同达达埃互致贺电", "desc": "10月12日，国家主席习近平同巴布亚新几内亚独立国总督达达埃互致贺电，庆祝两国建交50周年。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/23498e790ec72673a3e3ee478372308e", "author": "", "timestamp": 0, "hot": 7904746, "url": "https://www.baidu.com/s?wd=%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%8C%E8%BE%BE%E8%BE%BE%E5%9F%83%E4%BA%92%E8%87%B4%E8%B4%BA%E7%94%B5", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B9%A0%E8%BF%91%E5%B9%B3%E5%90%8C%E8%BE%BE%E8%BE%BE%E5%9F%83%E4%BA%92%E8%87%B4%E8%B4%BA%E7%94%B5"}, {"id": 0, "title": "两款燃油车重回销量榜前十", "desc": "2026年9月，乘联分会数据显示，两款一汽丰田燃油SUV重回乘用车零售销量前十，卡罗拉锐放与RAV4荣放分列第六、第八。此前8月该榜单前十曾被新能源全部包揽。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/69e3f02e96185bcacaeacdb943051451", "author": "", "timestamp": 0, "hot": 7808914, "url": "https://www.baidu.com/s?wd=%E4%B8%A4%E6%AC%BE%E7%87%83%E6%B2%B9%E8%BD%A6%E9%87%8D%E5%9B%9E%E9%94%80%E9%87%8F%E6%A6%9C%E5%89%8D%E5%8D%81", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%A4%E6%AC%BE%E7%87%83%E6%B2%B9%E8%BD%A6%E9%87%8D%E5%9B%9E%E9%94%80%E9%87%8F%E6%A6%9C%E5%89%8D%E5%8D%81"}, {"id": 1, "title": "中科院回应“住酒店可进天眼核心区”", "desc": "10月12日，中国科学院发布通报，针对网传游客付费入住特定酒店即可进入“中国天眼”核心区参观一事，已成立调查工作组开展全面核查。此前，该院收到相关反映。通报称，若发现违规违纪行为将严肃处理，结果将及时公布。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/c6394b98206e3285ce41f06b7cdb0f07", "author": "", "timestamp": 0, "hot": 7712324, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E7%A7%91%E9%99%A2%E5%9B%9E%E5%BA%94%E2%80%9C%E4%BD%8F%E9%85%92%E5%BA%97%E5%8F%AF%E8%BF%9B%E5%A4%A9%E7%9C%BC%E6%A0%B8%E5%BF%83%E5%8C%BA%E2%80%9D", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E7%A7%91%E9%99%A2%E5%9B%9E%E5%BA%94%E2%80%9C%E4%BD%8F%E9%85%92%E5%BA%97%E5%8F%AF%E8%BF%9B%E5%A4%A9%E7%9C%BC%E6%A0%B8%E5%BF%83%E5%8C%BA%E2%80%9D"}, {"id": 2, "title": "外国游客爱上中国科技", "desc": "近年来，入境游持续升温，来我国旅游的外国游客出行需求也发生了显著变化。以上海为例，除了外滩、豫园这样的传统地标，机器人互动、新能源汽车体验、无人驾驶等科创场景，越来越受到外国游客的喜爱。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8bfa4bbe49654938435c7d3ed00e5065", "author": "", "timestamp": 0, "hot": 7619057, "url": "https://www.baidu.com/s?wd=%E5%A4%96%E5%9B%BD%E6%B8%B8%E5%AE%A2%E7%88%B1%E4%B8%8A%E4%B8%AD%E5%9B%BD%E7%A7%91%E6%8A%80", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A4%96%E5%9B%BD%E6%B8%B8%E5%AE%A2%E7%88%B1%E4%B8%8A%E4%B8%AD%E5%9B%BD%E7%A7%91%E6%8A%80"}, {"id": 3, "title": "又一“中国造”全球爆单", "desc": "近年来，广东深圳的机器人产品加速出海，科技优势正在加快转化为出口竞争力。深圳海关最新数据显示，今年前8个月，深圳税则单独列名的各类机器人合计出口同比激增12倍。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/dff55b1f2c6059f994dd81ce6cc68107", "author": "", "timestamp": 0, "hot": 7520734, "url": "https://www.baidu.com/s?wd=%E5%8F%88%E4%B8%80%E2%80%9C%E4%B8%AD%E5%9B%BD%E9%80%A0%E2%80%9D%E5%85%A8%E7%90%83%E7%88%86%E5%8D%95", "mobileUrl": "https://www.baidu.com/s?wd=%E5%8F%88%E4%B8%80%E2%80%9C%E4%B8%AD%E5%9B%BD%E9%80%A0%E2%80%9D%E5%85%A8%E7%90%83%E7%88%86%E5%8D%95"}, {"id": 4, "title": "《我不是药神》原型24年吃了3.5万片药", "desc": "近期，《我不是药神》原型陆勇接受专访时表示，自己即将停药。陆勇透露，自己24年吃了约3.5万片药。此前，长期服药致其出现皮肤异常发白、水肿等副作用。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/83bff390446eba82acc9e2132b1f3020", "author": "", "timestamp": 0, "hot": 7427125, "url": "https://www.baidu.com/s?wd=%E3%80%8A%E6%88%91%E4%B8%8D%E6%98%AF%E8%8D%AF%E7%A5%9E%E3%80%8B%E5%8E%9F%E5%9E%8B24%E5%B9%B4%E5%90%83%E4%BA%863.5%E4%B8%87%E7%89%87%E8%8D%AF", "mobileUrl": "https://www.baidu.com/s?wd=%E3%80%8A%E6%88%91%E4%B8%8D%E6%98%AF%E8%8D%AF%E7%A5%9E%E3%80%8B%E5%8E%9F%E5%9E%8B24%E5%B9%B4%E5%90%83%E4%BA%863.5%E4%B8%87%E7%89%87%E8%8D%AF"}, {"id": 5, "title": "李娜自曝宣布退役后一个月怀孕", "desc": "日前，李娜在采访中自曝自己当时9月宣布退役，10月便怀孕，澄清并非先怀孕才退役，顺其自然进入下一个角色。李娜与教练姜山结婚20年，育有一女一子。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/545bc1761c3ad8e0b420b96d11372cf1", "author": "", "timestamp": 0, "hot": 7332050, "url": "https://www.baidu.com/s?wd=%E6%9D%8E%E5%A8%9C%E8%87%AA%E6%9B%9D%E5%AE%A3%E5%B8%83%E9%80%80%E5%BD%B9%E5%90%8E%E4%B8%80%E4%B8%AA%E6%9C%88%E6%80%80%E5%AD%95", "mobileUrl": "https://www.baidu.com/s?wd=%E6%9D%8E%E5%A8%9C%E8%87%AA%E6%9B%9D%E5%AE%A3%E5%B8%83%E9%80%80%E5%BD%B9%E5%90%8E%E4%B8%80%E4%B8%AA%E6%9C%88%E6%80%80%E5%AD%95"}, {"id": 6, "title": "美股存储、光通信暴跌", "desc": "美东时间周一，美股三大指数收盘涨跌不一。半导体板块普跌，费城半导体指数跌超2.6%，存储、光通信股大跌。Lumentum重挫近10%，应用光电、Coherent跌超7%，康宁、闪迪跌超5%，SK海力士、超微电脑、ARM、美光、希捷跟跌。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/0795916f8563a7e8970643066bfb1c4b", "author": "", "timestamp": 0, "hot": 7234774, "url": "https://www.baidu.com/s?wd=%E7%BE%8E%E8%82%A1%E5%AD%98%E5%82%A8%E3%80%81%E5%85%89%E9%80%9A%E4%BF%A1%E6%9A%B4%E8%B7%8C", "mobileUrl": "https://www.baidu.com/s?wd=%E7%BE%8E%E8%82%A1%E5%AD%98%E5%82%A8%E3%80%81%E5%85%89%E9%80%9A%E4%BF%A1%E6%9A%B4%E8%B7%8C"}, {"id": 7, "title": "老板轻拍顾客提醒上菜 顾客摔盘离开", "desc": "近日，在浙江一家餐厅，老板给低头吃饭的女子端面上菜时，轻拍对方提醒。该女子突然暴怒，将盘子砸向老板并辱骂后直接离开。老板被砸致胳膊淤青，最终未报警处理。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/578a0ae51d2342b8032e5bbf97130342", "author": "", "timestamp": 0, "hot": 7139511, "url": "https://www.baidu.com/s?wd=%E8%80%81%E6%9D%BF%E8%BD%BB%E6%8B%8D%E9%A1%BE%E5%AE%A2%E6%8F%90%E9%86%92%E4%B8%8A%E8%8F%9C%20%E9%A1%BE%E5%AE%A2%E6%91%94%E7%9B%98%E7%A6%BB%E5%BC%80", "mobileUrl": "https://www.baidu.com/s?wd=%E8%80%81%E6%9D%BF%E8%BD%BB%E6%8B%8D%E9%A1%BE%E5%AE%A2%E6%8F%90%E9%86%92%E4%B8%8A%E8%8F%9C+%E9%A1%BE%E5%AE%A2%E6%91%94%E7%9B%98%E7%A6%BB%E5%BC%80"}, {"id": 8, "title": "C罗凌空斩建功 距离千球只差19球", "desc": "北京时间10月13日凌晨3点15分，2026-27赛季亚冠精英联赛西亚区第2轮，利雅得胜利主场迎战费尔干纳油工。本场比赛C罗凌空斩建功，职业生涯总进球数达到981球，距离千球目标仅差19球。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b42ca9985eada5af66502d85ed8cedc7", "author": "", "timestamp": 0, "hot": 7043861, "url": "https://www.baidu.com/s?wd=C%E7%BD%97%E5%87%8C%E7%A9%BA%E6%96%A9%E5%BB%BA%E5%8A%9F%20%E8%B7%9D%E7%A6%BB%E5%8D%83%E7%90%83%E5%8F%AA%E5%B7%AE19%E7%90%83", "mobileUrl": "https://www.baidu.com/s?wd=C%E7%BD%97%E5%87%8C%E7%A9%BA%E6%96%A9%E5%BB%BA%E5%8A%9F+%E8%B7%9D%E7%A6%BB%E5%8D%83%E7%90%83%E5%8F%AA%E5%B7%AE19%E7%90%83"}, {"id": 9, "title": "开拓者狂胜53分 杨瀚森13分4板4助", "desc": "北京时间10月13日，NBA季前赛继续开打，伦敦雄狮迎战开拓者。最终经过四节较量，开拓者以119-66大胜伦敦雄狮，杨瀚森13分4板4助，克林根11分6板。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/da0ffeb18c5d1a20af23a87493459a76", "author": "", "timestamp": 0, "hot": 6948346, "url": "https://www.baidu.com/s?wd=%E5%BC%80%E6%8B%93%E8%80%85%E7%8B%82%E8%83%9C53%E5%88%86%20%E6%9D%A8%E7%80%9A%E6%A3%AE13%E5%88%864%E6%9D%BF4%E5%8A%A9", "mobileUrl": "https://www.baidu.com/s?wd=%E5%BC%80%E6%8B%93%E8%80%85%E7%8B%82%E8%83%9C53%E5%88%86+%E6%9D%A8%E7%80%9A%E6%A3%AE13%E5%88%864%E6%9D%BF4%E5%8A%A9"}, {"id": 10, "title": "北京热力辟谣代缴采暖费能打折", "desc": "近日，北京热力辟谣称，从未授权个人代收代缴采暖费。起因是部分不法人员在闲鱼、小红书等平台自称“内部人员”，以打折优惠诱导居民向个人账户转账，或假冒供热企业员工索要银行卡等敏感信息。北京热力提醒，私下代缴打折一律不要相信，用户应通过官方小程序、合作银行网点等正规途径缴费。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f3981293ad21df60837d7336668d46b4", "author": "", "timestamp": 0, "hot": 6853355, "url": "https://www.baidu.com/s?wd=%E5%8C%97%E4%BA%AC%E7%83%AD%E5%8A%9B%E8%BE%9F%E8%B0%A3%E4%BB%A3%E7%BC%B4%E9%87%87%E6%9A%96%E8%B4%B9%E8%83%BD%E6%89%93%E6%8A%98", "mobileUrl": "https://www.baidu.com/s?wd=%E5%8C%97%E4%BA%AC%E7%83%AD%E5%8A%9B%E8%BE%9F%E8%B0%A3%E4%BB%A3%E7%BC%B4%E9%87%87%E6%9A%96%E8%B4%B9%E8%83%BD%E6%89%93%E6%8A%98"}, {"id": 11, "title": "撒贝宁龙凤胎长这么大了", "desc": "近日，撒贝宁一家四口被网友偶遇，其龙凤胎孩子现已7岁，已经步入小学，身高长至撒贝宁腰部。两个孩子遗传母亲李白的基因，身形高挑，相关画面曝光后，引发网友关注。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b74177930a2f6b1839ada60abc3b5375", "author": "", "timestamp": 0, "hot": 6758632, "url": "https://www.baidu.com/s?wd=%E6%92%92%E8%B4%9D%E5%AE%81%E9%BE%99%E5%87%A4%E8%83%8E%E9%95%BF%E8%BF%99%E4%B9%88%E5%A4%A7%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E6%92%92%E8%B4%9D%E5%AE%81%E9%BE%99%E5%87%A4%E8%83%8E%E9%95%BF%E8%BF%99%E4%B9%88%E5%A4%A7%E4%BA%86"}, {"id": 12, "title": "新人结婚66个拱门从新郎家摆到新娘家", "desc": "近日，山东菏泽曹县一对新人办婚礼，66个充气拱门从新郎家一路绵延1.4公里摆至新娘家，引发热议。据新郎陈先生介绍，之所以摆这么多拱门是出于对新娘的喜欢和重视，新娘得知之后也非常高兴。村里邻里也都帮忙给拱门充气、充电。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/610121a68f962dffd4eebc3265557d0a", "author": "", "timestamp": 0, "hot": 6659675, "url": "https://www.baidu.com/s?wd=%E6%96%B0%E4%BA%BA%E7%BB%93%E5%A9%9A66%E4%B8%AA%E6%8B%B1%E9%97%A8%E4%BB%8E%E6%96%B0%E9%83%8E%E5%AE%B6%E6%91%86%E5%88%B0%E6%96%B0%E5%A8%98%E5%AE%B6", "mobileUrl": "https://www.baidu.com/s?wd=%E6%96%B0%E4%BA%BA%E7%BB%93%E5%A9%9A66%E4%B8%AA%E6%8B%B1%E9%97%A8%E4%BB%8E%E6%96%B0%E9%83%8E%E5%AE%B6%E6%91%86%E5%88%B0%E6%96%B0%E5%A8%98%E5%AE%B6"}, {"id": 13, "title": "“共享儿女”你能接受吗", "desc": "“共享儿女”正填补老龄化社会的孤独缺口——年轻人用陪伴换取归属感，老人收获温暖与帮助。这既是供需错配下的创新方案，也暗藏边界模糊、信任缺失等风险。“共享儿女”能陪老人散步、聊天，却替代不了子女的那通电话和那个拥抱。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ca68e9b944289bf1750ed58d00d9b003", "author": "", "timestamp": 0, "hot": 6562967, "url": "https://www.baidu.com/s?wd=%E2%80%9C%E5%85%B1%E4%BA%AB%E5%84%BF%E5%A5%B3%E2%80%9D%E4%BD%A0%E8%83%BD%E6%8E%A5%E5%8F%97%E5%90%97", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9C%E5%85%B1%E4%BA%AB%E5%84%BF%E5%A5%B3%E2%80%9D%E4%BD%A0%E8%83%BD%E6%8E%A5%E5%8F%97%E5%90%97"}, {"id": 14, "title": "女子左臀疼1个月挤出发黑注射针头", "desc": "10月11日，浙江一名女子分享经历，自己左臀疼痛一月，洗澡时挤出一根约4厘米发黑生锈的注射针头。她此前臀部就有刺痛剧痛，日常骑共享单车上班，无法确定针头来源。当事人已完成四项传染病筛查，结果均为阴性，针头来历依旧不明。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8d878e4d0e40e86f872e6d67a9e3dbd1", "author": "", "timestamp": 0, "hot": 6466603, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E5%B7%A6%E8%87%80%E7%96%BC1%E4%B8%AA%E6%9C%88%E6%8C%A4%E5%87%BA%E5%8F%91%E9%BB%91%E6%B3%A8%E5%B0%84%E9%92%88%E5%A4%B4", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E5%B7%A6%E8%87%80%E7%96%BC1%E4%B8%AA%E6%9C%88%E6%8C%A4%E5%87%BA%E5%8F%91%E9%BB%91%E6%B3%A8%E5%B0%84%E9%92%88%E5%A4%B4"}, {"id": 15, "title": "29万亿应收账款该怎么清欠", "desc": "近日，工信部等在国务院政策例行吹风会上表态，针对地方政府、央国企和大型企业三大拖欠主力从源头破局。此前8月末，规上工业企业应收账款达29.48万亿元创新高，大企业利用优势“卷账期”套利致中小企业资金链断裂。日前，国务院办公厅印发通知，要求大企业60日内付款，严防“边清边欠”。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/e33559c402171d7be977a0cdd2618f0a", "author": "", "timestamp": 0, "hot": 6378234, "url": "https://www.baidu.com/s?wd=29%E4%B8%87%E4%BA%BF%E5%BA%94%E6%94%B6%E8%B4%A6%E6%AC%BE%E8%AF%A5%E6%80%8E%E4%B9%88%E6%B8%85%E6%AC%A0", "mobileUrl": "https://www.baidu.com/s?wd=29%E4%B8%87%E4%BA%BF%E5%BA%94%E6%94%B6%E8%B4%A6%E6%AC%BE%E8%AF%A5%E6%80%8E%E4%B9%88%E6%B8%85%E6%AC%A0"}, {"id": 16, "title": "儿子帮妈妈拔针步步做错", "desc": "近日，一妈妈高烧输液，儿子好心帮忙拔针。儿子拔针时每步认真却全做错，不仅将胶布粘反，还在拔出针头后不知用纱布按压止血，场面令人哭笑不得。网友调侃称：“没把针扎回去就不错了。”", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/21ae23d9fb4a0356161eca76eaf2718a", "author": "", "timestamp": 0, "hot": 6285135, "url": "https://www.baidu.com/s?wd=%E5%84%BF%E5%AD%90%E5%B8%AE%E5%A6%88%E5%A6%88%E6%8B%94%E9%92%88%E6%AD%A5%E6%AD%A5%E5%81%9A%E9%94%99", "mobileUrl": "https://www.baidu.com/s?wd=%E5%84%BF%E5%AD%90%E5%B8%AE%E5%A6%88%E5%A6%88%E6%8B%94%E9%92%88%E6%AD%A5%E6%AD%A5%E5%81%9A%E9%94%99"}, {"id": 17, "title": "被继母怀疑拿钱 女孩自学开车出走", "desc": "近日，一15岁女孩在贵州凯里西收费站被交警拦下。此前，其继母怀疑女孩拿了100元，女孩觉得委屈负气出走，拿走车钥匙靠看视频自学开车，从湖南开到贵州。最终，女孩因无证驾驶被罚款1000元，民警已联系家属接回。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/4a87c499c71c314cd26052eea982d7c6", "author": "", "timestamp": 0, "hot": 6183237, "url": "https://www.baidu.com/s?wd=%E8%A2%AB%E7%BB%A7%E6%AF%8D%E6%80%80%E7%96%91%E6%8B%BF%E9%92%B1%20%E5%A5%B3%E5%AD%A9%E8%87%AA%E5%AD%A6%E5%BC%80%E8%BD%A6%E5%87%BA%E8%B5%B0", "mobileUrl": "https://www.baidu.com/s?wd=%E8%A2%AB%E7%BB%A7%E6%AF%8D%E6%80%80%E7%96%91%E6%8B%BF%E9%92%B1+%E5%A5%B3%E5%AD%A9%E8%87%AA%E5%AD%A6%E5%BC%80%E8%BD%A6%E5%87%BA%E8%B5%B0"}, {"id": 18, "title": "美知名歌手突然去世后家人为钱闹翻", "desc": "不久前，田纳西州纳什维尔一名法官批准临时限制令，要求已故美国乡村音乐歌星多莉·帕顿的侄子及其安保公司，与遗产管理公司保持至少1000英尺距离。此前，多莉于当地时间8月25日去世。因多莉无子女且身价不菲，其侄子此前向遗产管理公司发送威胁信息，核心矛盾为钱。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/a4a978b32efc9059c54be48a6ba119fa", "author": "", "timestamp": 0, "hot": 6079228, "url": "https://www.baidu.com/s?wd=%E7%BE%8E%E7%9F%A5%E5%90%8D%E6%AD%8C%E6%89%8B%E7%AA%81%E7%84%B6%E5%8E%BB%E4%B8%96%E5%90%8E%E5%AE%B6%E4%BA%BA%E4%B8%BA%E9%92%B1%E9%97%B9%E7%BF%BB", "mobileUrl": "https://www.baidu.com/s?wd=%E7%BE%8E%E7%9F%A5%E5%90%8D%E6%AD%8C%E6%89%8B%E7%AA%81%E7%84%B6%E5%8E%BB%E4%B8%96%E5%90%8E%E5%AE%B6%E4%BA%BA%E4%B8%BA%E9%92%B1%E9%97%B9%E7%BF%BB"}, {"id": 19, "title": "Meta推出新模型Muse Wonder", "desc": "Meta推出新一代人工智能（AI）模型Muse Wonder及Muse Wonder Full，称其在个人和专业智能体任务上达到行业前沿水平。Meta CEO扎克伯格表示，这是公司朝着向所有人提供“个人超级智能”迈出的重要一步。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/9f9da02c85be3cb777a28bc90831be13", "author": "", "timestamp": 0, "hot": 5991506, "url": "https://www.baidu.com/s?wd=Meta%E6%8E%A8%E5%87%BA%E6%96%B0%E6%A8%A1%E5%9E%8BMuse%20Wonder", "mobileUrl": "https://www.baidu.com/s?wd=Meta%E6%8E%A8%E5%87%BA%E6%96%B0%E6%A8%A1%E5%9E%8BMuse+Wonder"}, {"id": 20, "title": "这台缝纫机凭什么卖遍207个国家", "desc": "我国是全球最大的工业缝纫机生产国，产量占全球八成以上，产品出口到200多个国家和地区。浙江台州一家缝制设备企业，如何缝出全球大市场？据悉，这款机器搭载自研芯片，不用反复调试参数，牛仔布、网纱、魔术贴等厚薄差异巨大的面料，都可以连续稳定缝制，工作效率提升30%。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/a88b296b826593b31a569757ba8431c8", "author": "", "timestamp": 0, "hot": 5904902, "url": "https://www.baidu.com/s?wd=%E8%BF%99%E5%8F%B0%E7%BC%9D%E7%BA%AB%E6%9C%BA%E5%87%AD%E4%BB%80%E4%B9%88%E5%8D%96%E9%81%8D207%E4%B8%AA%E5%9B%BD%E5%AE%B6", "mobileUrl": "https://www.baidu.com/s?wd=%E8%BF%99%E5%8F%B0%E7%BC%9D%E7%BA%AB%E6%9C%BA%E5%87%AD%E4%BB%80%E4%B9%88%E5%8D%96%E9%81%8D207%E4%B8%AA%E5%9B%BD%E5%AE%B6"}, {"id": 21, "title": "比亚迪副总裁：5年内登顶全球销量第1", "desc": "10月11日消息，日前比亚迪执行副总裁李柯在新加坡一场峰会上表示，计划五年内赶超丰田和大众登顶全球车企第一。她表示，比亚迪将坚持出海战略，持续开拓欧洲、中美洲、南美洲、亚洲和大洋洲市场，并强调公司在储能、光伏、电池等多个领域实现领跑，电池技术是核心竞争力之一，优势不只在汽车。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/6c05e4db253c8ada73139e16f13fb871", "author": "", "timestamp": 0, "hot": 5795182, "url": "https://www.baidu.com/s?wd=%E6%AF%94%E4%BA%9A%E8%BF%AA%E5%89%AF%E6%80%BB%E8%A3%81%EF%BC%9A5%E5%B9%B4%E5%86%85%E7%99%BB%E9%A1%B6%E5%85%A8%E7%90%83%E9%94%80%E9%87%8F%E7%AC%AC1", "mobileUrl": "https://www.baidu.com/s?wd=%E6%AF%94%E4%BA%9A%E8%BF%AA%E5%89%AF%E6%80%BB%E8%A3%81%EF%BC%9A5%E5%B9%B4%E5%86%85%E7%99%BB%E9%A1%B6%E5%85%A8%E7%90%83%E9%94%80%E9%87%8F%E7%AC%AC1"}, {"id": 22, "title": "女子长假把宠物鸡寄养在养鸡场", "desc": "国庆长假，杨女士因外出，将惧怕猫狗的宠物鸡寄养在散养养鸡场。9天后接回，鸡体重下降八两，眼周也被啄破。但鸡回到家中次日就恢复状态，还改掉熬夜、吃宵夜的坏习惯，瘦下来之后身体反而更为健康。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/75deed154e926282f8e040e14133c9b6", "author": "", "timestamp": 0, "hot": 5704005, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E9%95%BF%E5%81%87%E6%8A%8A%E5%AE%A0%E7%89%A9%E9%B8%A1%E5%AF%84%E5%85%BB%E5%9C%A8%E5%85%BB%E9%B8%A1%E5%9C%BA", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E9%95%BF%E5%81%87%E6%8A%8A%E5%AE%A0%E7%89%A9%E9%B8%A1%E5%AF%84%E5%85%BB%E5%9C%A8%E5%85%BB%E9%B8%A1%E5%9C%BA"}, {"id": 23, "title": "内娱来了五位AI艺人", "desc": "近日，内娱新出道了五位AI艺人，‌他们由芒果打造，分别是程渡、方屿、林恩娜、戚许、展颜，首部主演作品定档10月14日上线‌。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/eff6d03b4994a86bbb0002fdc79ec683", "author": "", "timestamp": 0, "hot": 5620297, "url": "https://www.baidu.com/s?wd=%E5%86%85%E5%A8%B1%E6%9D%A5%E4%BA%86%E4%BA%94%E4%BD%8DAI%E8%89%BA%E4%BA%BA", "mobileUrl": "https://www.baidu.com/s?wd=%E5%86%85%E5%A8%B1%E6%9D%A5%E4%BA%86%E4%BA%94%E4%BD%8DAI%E8%89%BA%E4%BA%BA"}, {"id": 24, "title": "梅婷回应女儿演戏", "desc": "近日，受访时梅婷回应女儿快快出演影视作品一事，表示因女儿现阶段喜欢演戏便让其尝试。快快自己去见导演试戏后被选用，梅婷全程未参与。此前，快快在电影《好东西》中饰演王茉莉，收获好评并入围第38届大众电影百花奖最佳新人提名。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f005ba745831622d419785a7adfcf214", "author": "", "timestamp": 0, "hot": 5524427, "url": "https://www.baidu.com/s?wd=%E6%A2%85%E5%A9%B7%E5%9B%9E%E5%BA%94%E5%A5%B3%E5%84%BF%E6%BC%94%E6%88%8F", "mobileUrl": "https://www.baidu.com/s?wd=%E6%A2%85%E5%A9%B7%E5%9B%9E%E5%BA%94%E5%A5%B3%E5%84%BF%E6%BC%94%E6%88%8F"}, {"id": 25, "title": "哈药总裁突遭留置 曾陷豪华装修风波", "desc": "10月12日，哈药股份公告，公司于近日收到相关监察委员会关于公司董事、总裁芦传有的《立案通知书》和《留置通知书》。据悉，芦传有担任哈药六厂厂长期间，该厂曾因办公楼装修豪华而陷入舆论风波。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/94f11755c12bfec965a1fd96beee4049", "author": "", "timestamp": 0, "hot": 5405883, "url": "https://www.baidu.com/s?wd=%E5%93%88%E8%8D%AF%E6%80%BB%E8%A3%81%E7%AA%81%E9%81%AD%E7%95%99%E7%BD%AE%20%E6%9B%BE%E9%99%B7%E8%B1%AA%E5%8D%8E%E8%A3%85%E4%BF%AE%E9%A3%8E%E6%B3%A2", "mobileUrl": "https://www.baidu.com/s?wd=%E5%93%88%E8%8D%AF%E6%80%BB%E8%A3%81%E7%AA%81%E9%81%AD%E7%95%99%E7%BD%AE+%E6%9B%BE%E9%99%B7%E8%B1%AA%E5%8D%8E%E8%A3%85%E4%BF%AE%E9%A3%8E%E6%B3%A2"}, {"id": 26, "title": "“不烧心”火了 别让良心凉了", "desc": "近日，“不烧心文学”走红网络。对此，媒体发表评论文章称：生意可以精打细算，良心不能斤斤计较，不烧心火了别让良心凉了。据悉，“不烧心”原意是指食物或饮品干净、用料实在，吃下去胃里没有灼热难受的感觉。而现在全网爆火的“不烧心文学”则出自套路化的AI短剧。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b426e7cd13402ad952cff0f34c59c3f3", "author": "", "timestamp": 0, "hot": 5329548, "url": "https://www.baidu.com/s?wd=%E2%80%9C%E4%B8%8D%E7%83%A7%E5%BF%83%E2%80%9D%E7%81%AB%E4%BA%86%20%E5%88%AB%E8%AE%A9%E8%89%AF%E5%BF%83%E5%87%89%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9C%E4%B8%8D%E7%83%A7%E5%BF%83%E2%80%9D%E7%81%AB%E4%BA%86+%E5%88%AB%E8%AE%A9%E8%89%AF%E5%BF%83%E5%87%89%E4%BA%86"}, {"id": 27, "title": "女子凌晨被撬窗掳走送戒网瘾机构", "desc": "近日，一名31岁女子凌晨两点遭人撬窗掳走。因其兼职游戏陪玩被父亲认定沉迷网络，被送入戒网瘾机构 “治疗” 159天，期间遭到教官殴打，还曾以绝食谋求离开。事后女子起诉该机构，拉黑父亲并搬离住处。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f34ec5314bcb48ed7e93f8cd94e6a77e", "author": "", "timestamp": 0, "hot": 5234627, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E5%87%8C%E6%99%A8%E8%A2%AB%E6%92%AC%E7%AA%97%E6%8E%B3%E8%B5%B0%E9%80%81%E6%88%92%E7%BD%91%E7%98%BE%E6%9C%BA%E6%9E%84", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E5%87%8C%E6%99%A8%E8%A2%AB%E6%92%AC%E7%AA%97%E6%8E%B3%E8%B5%B0%E9%80%81%E6%88%92%E7%BD%91%E7%98%BE%E6%9C%BA%E6%9E%84"}, {"id": 28, "title": "俄乌能源停火果然是一个大乌龙", "desc": "近日，特朗普宣布：即刻起（10月11日），俄乌冲突进入“能源停火”状态，双方均已同意。请不要破坏！对此，泽连斯基第一时间表态：这对我来说，也是条新闻！俄罗斯方面，则一直保持沉默。显然，所谓俄乌同意“能源停火”，只是特朗普的一厢情愿，但居然就当成既定事实向世界官宣了。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/efdef4b433254b0e9b63c89e7e205465", "author": "", "timestamp": 0, "hot": 5136426, "url": "https://www.baidu.com/s?wd=%E4%BF%84%E4%B9%8C%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB%E6%9E%9C%E7%84%B6%E6%98%AF%E4%B8%80%E4%B8%AA%E5%A4%A7%E4%B9%8C%E9%BE%99", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BF%84%E4%B9%8C%E8%83%BD%E6%BA%90%E5%81%9C%E7%81%AB%E6%9E%9C%E7%84%B6%E6%98%AF%E4%B8%80%E4%B8%AA%E5%A4%A7%E4%B9%8C%E9%BE%99"}]}