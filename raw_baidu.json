 "", "timestamp": 0, "hot": 7328372, "url": "https://www.baidu.com/s?wd=%E7%89%B9%E6%9C%97%E6%99%AE%EF%BC%9A%E8%BF%99%E6%AC%A1%E8%AE%BF%E9%97%AE%E5%AF%8C%E6%9C%89%E6%88%90%E6%95%88", "mobileUrl": "https://www.baidu.com/s?wd=%E7%89%B9%E6%9C%97%E6%99%AE%EF%BC%9A%E8%BF%99%E6%AC%A1%E8%AE%BF%E9%97%AE%E5%AF%8C%E6%9C%89%E6%88%90%E6%95%88"}, {"id": 6, "title": "张雪机车员工晒中秋福利", "desc": "中秋节期间，张雪员工晒出公司中秋福利。福利包含梭子蟹、蟹卡、美心月饼，以及张雪从哈密带回来的葡萄干和翠玉冰糖梨，员工直呼感觉要吃胖。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/c9c4000dbb86f7d4c135bd44072ba6f4", "author": "", "timestamp": 0, "hot": 7237251, "url": "https://www.baidu.com/s?wd=%E5%BC%A0%E9%9B%AA%E6%9C%BA%E8%BD%A6%E5%91%98%E5%B7%A5%E6%99%92%E4%B8%AD%E7%A7%8B%E7%A6%8F%E5%88%A9", "mobileUrl": "https://www.baidu.com/s?wd=%E5%BC%A0%E9%9B%AA%E6%9C%BA%E8%BD%A6%E5%91%98%E5%B7%A5%E6%99%92%E4%B8%AD%E7%A7%8B%E7%A6%8F%E5%88%A9"}, {"id": 7, "title": "小孩姐能飞", "desc": "“小孩姐能飞！”9月25日名古屋亚运会田径女子100米决赛，中国选手陈妤颉跑出11秒06斩获金牌。赛后，总台体育评论员崔骁、孙思辰在赛场对这场精彩的百米对决作出现场点评。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/3ad6edbe545fa07054ca6de933092549", "author": "", "timestamp": 0, "hot": 7138854, "url": "https://www.baidu.com/s?wd=%E5%B0%8F%E5%AD%A9%E5%A7%90%E8%83%BD%E9%A3%9E", "mobileUrl": "https://www.baidu.com/s?wd=%E5%B0%8F%E5%AD%A9%E5%A7%90%E8%83%BD%E9%A3%9E"}, {"id": 8, "title": "低糖月饼、文创月饼走俏", "desc": "今年中秋，我国月饼市场呈现新变化，低糖、低油及文创月饼走俏。电商平台“低糖月饼”搜索量同比涨320%，文创月饼市场份额超20%。同时月饼出海热销，已出口全球40多个国家。预计今年整体市场规模将达290亿元。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/2e6ceaa170b3153f91a70e8df114dc1d", "author": "", "timestamp": 0, "hot": 7045999, "url": "https://www.baidu.com/s?wd=%E4%BD%8E%E7%B3%96%E6%9C%88%E9%A5%BC%E3%80%81%E6%96%87%E5%88%9B%E6%9C%88%E9%A5%BC%E8%B5%B0%E4%BF%8F", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BD%8E%E7%B3%96%E6%9C%88%E9%A5%BC%E3%80%81%E6%96%87%E5%88%9B%E6%9C%88%E9%A5%BC%E8%B5%B0%E4%BF%8F"}, {"id": 9, "title": "中美元首夫妇参观美国国家档案馆", "desc": "当地时间9月25日上午，国家主席习近平和夫人彭丽媛在美国总统特朗普和夫人梅拉尼娅陪同下参观美国国家档案馆。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/45ca6e43f5edcc69347bb38222338c0e", "author": "", "timestamp": 0, "hot": 6946762, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E7%BE%8E%E5%85%83%E9%A6%96%E5%A4%AB%E5%A6%87%E5%8F%82%E8%A7%82%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%AE%B6%E6%A1%A3%E6%A1%88%E9%A6%86", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E7%BE%8E%E5%85%83%E9%A6%96%E5%A4%AB%E5%A6%87%E5%8F%82%E8%A7%82%E7%BE%8E%E5%9B%BD%E5%9B%BD%E5%AE%B6%E6%A1%A3%E6%A1%88%E9%A6%86"}, {"id": 10, "title": "月饼和螃蟹一起吃会中毒？假的", "desc": "网传月饼和螃蟹同吃会中毒是谣言。二者同食不会产生毒素，但二者叠加确实会加重肠胃负担。若出现腹胀腹泻多因过量食用，也可能是螃蟹不新鲜、未煮熟所致。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/d3013fb1532292314be40790deb7bfe7", "author": "", "timestamp": 0, "hot": 6855727, "url": "https://www.baidu.com/s?wd=%E6%9C%88%E9%A5%BC%E5%92%8C%E8%9E%83%E8%9F%B9%E4%B8%80%E8%B5%B7%E5%90%83%E4%BC%9A%E4%B8%AD%E6%AF%92%EF%BC%9F%E5%81%87%E7%9A%84", "mobileUrl": "https://www.baidu.com/s?wd=%E6%9C%88%E9%A5%BC%E5%92%8C%E8%9E%83%E8%9F%B9%E4%B8%80%E8%B5%B7%E5%90%83%E4%BC%9A%E4%B8%AD%E6%AF%92%EF%BC%9F%E5%81%87%E7%9A%84"}, {"id": 11, "title": "刚死不久的螃蟹还能吃吗", "desc": "螃蟹死后细菌会繁殖生成组胺毒素，河蟹风险更高。即便刚死不久，常温存放也会快速变质，毒素高温难以消除。若无法确定死亡时长，或是出现发黏、异味，就不建议食用，最好优先吃鲜活螃蟹，避免食物中毒。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b51f2c95995e8d98e93a971b0e53716f", "author": "", "timestamp": 0, "hot": 6755954, "url": "https://www.baidu.com/s?wd=%E5%88%9A%E6%AD%BB%E4%B8%8D%E4%B9%85%E7%9A%84%E8%9E%83%E8%9F%B9%E8%BF%98%E8%83%BD%E5%90%83%E5%90%97", "mobileUrl": "https://www.baidu.com/s?wd=%E5%88%9A%E6%AD%BB%E4%B8%8D%E4%B9%85%E7%9A%84%E8%9E%83%E8%9F%B9%E8%BF%98%E8%83%BD%E5%90%83%E5%90%97"}, {"id": 12, "title": "国家出手调控油价了", "desc": "9月11日国内成品油价格调整以来，国际市场原油价格快速上涨后回落，近日又再度冲高。为减缓国际油价上涨对国内的冲击，国家继续对国内成品油价格采取临时调控措施。自9月24日24时起，国内汽、柴油价格每吨分别应上调830元、800元，调控后实际上调395元、385元。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f8896aae9dd71daedd50796d359f6f2c", "author": "", "timestamp": 0, "hot": 6657687, "url": "https://www.baidu.com/s?wd=%E5%9B%BD%E5%AE%B6%E5%87%BA%E6%89%8B%E8%B0%83%E6%8E%A7%E6%B2%B9%E4%BB%B7%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E5%9B%BD%E5%AE%B6%E5%87%BA%E6%89%8B%E8%B0%83%E6%8E%A7%E6%B2%B9%E4%BB%B7%E4%BA%86"}, {"id": 13, "title": "基辅再次发生剧烈爆炸", "desc": "当地时间9月25日，乌克兰首都基辅再次发生剧烈爆炸。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/70e702cd1fcee75345c397d9112245f7", "author": "", "timestamp": 0, "hot": 6563505, "url": "https://www.baidu.com/s?wd=%E5%9F%BA%E8%BE%85%E5%86%8D%E6%AC%A1%E5%8F%91%E7%94%9F%E5%89%A7%E7%83%88%E7%88%86%E7%82%B8", "mobileUrl": "https://www.baidu.com/s?wd=%E5%9F%BA%E8%BE%85%E5%86%8D%E6%AC%A1%E5%8F%91%E7%94%9F%E5%89%A7%E7%83%88%E7%88%86%E7%82%B8"}, {"id": 14, "title": "四川宜宾发生4.5级地震", "desc": "中国地震台网正式测定：9月26日5时01分，在四川宜宾市高县（北纬28.52度，东经104.67度）发生4.5级地震，震源深度5公里。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/e1e75ede18281065ba9b0aa7dd54208f", "author": "", "timestamp": 0, "hot": 6471846, "url": "https://www.baidu.com/s?wd=%E5%9B%9B%E5%B7%9D%E5%AE%9C%E5%AE%BE%E5%8F%91%E7%94%9F4.5%E7%BA%A7%E5%9C%B0%E9%9C%87", "mobileUrl": "https://www.baidu.com/s?wd=%E5%9B%9B%E5%B7%9D%E5%AE%9C%E5%AE%BE%E5%8F%91%E7%94%9F4.5%E7%BA%A7%E5%9C%B0%E9%9C%87"}, {"id": 15, "title": "亚运会今日看点：男足冲击四强", "desc": "9月26日，2026名古屋亚运会赛事继续进行，今日看点：中国男足亚运队将在四分之一决赛对阵泰国队，冲击四强。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/c814ed61a448723ff307305f5febedc0", "author": "", "timestamp": 0, "hot": 6376588, "url": "https://www.baidu.com/s?wd=%E4%BA%9A%E8%BF%90%E4%BC%9A%E4%BB%8A%E6%97%A5%E7%9C%8B%E7%82%B9%EF%BC%9A%E7%94%B7%E8%B6%B3%E5%86%B2%E5%87%BB%E5%9B%9B%E5%BC%BA", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BA%9A%E8%BF%90%E4%BC%9A%E4%BB%8A%E6%97%A5%E7%9C%8B%E7%82%B9%EF%BC%9A%E7%94%B7%E8%B6%B3%E5%86%B2%E5%87%BB%E5%9B%9B%E5%BC%BA"}, {"id": 16, "title": "王楚钦孙颖莎冲击亚运混双三连冠", "desc": "9月26日，亚运会赛场将产生25枚金牌。乒乓球混双决赛在两对中国组合间展开，王楚钦/孙颖莎若夺冠将实现亚运混双三连冠。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f4f17c443d73e2dd5d31cfab6656fb41", "author": "", "timestamp": 0, "hot": 6278221, "url": "https://www.baidu.com/s?wd=%E7%8E%8B%E6%A5%9A%E9%92%A6%E5%AD%99%E9%A2%96%E8%8E%8E%E5%86%B2%E5%87%BB%E4%BA%9A%E8%BF%90%E6%B7%B7%E5%8F%8C%E4%B8%89%E8%BF%9E%E5%86%A0", "mobileUrl": "https://www.baidu.com/s?wd=%E7%8E%8B%E6%A5%9A%E9%92%A6%E5%AD%99%E9%A2%96%E8%8E%8E%E5%86%B2%E5%87%BB%E4%BA%9A%E8%BF%90%E6%B7%B7%E5%8F%8C%E4%B8%89%E8%BF%9E%E5%86%A0"}, {"id": 17, "title": "我怕咬缺了它 爸爸找不到回家的路", "desc": "中秋佳节，杭州一小学生以《给爸爸留的圆月亮》为题，写下：“我怕咬缺了它，在外工作的爸爸就找不到回家的路。”细腻的笔触感动一众网友。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/c73b8194605f8523edd4b3bafd715008", "author": "", "timestamp": 0, "hot": 6185853, "url": "https://www.baidu.com/s?wd=%E6%88%91%E6%80%95%E5%92%AC%E7%BC%BA%E4%BA%86%E5%AE%83%20%E7%88%B8%E7%88%B8%E6%89%BE%E4%B8%8D%E5%88%B0%E5%9B%9E%E5%AE%B6%E7%9A%84%E8%B7%AF", "mobileUrl": "https://www.baidu.com/s?wd=%E6%88%91%E6%80%95%E5%92%AC%E7%BC%BA%E4%BA%86%E5%AE%83+%E7%88%B8%E7%88%B8%E6%89%BE%E4%B8%8D%E5%88%B0%E5%9B%9E%E5%AE%B6%E7%9A%84%E8%B7%AF"}, {"id": 18, "title": "尼泊尔：想找中印合作", "desc": "据彭博社9月25日报道，尼泊尔总理沙阿在联合国大会提议与中印建立“喜马拉雅气候韧性机制”。起因是8月26日尼泊尔与中国边境附近发生毁灭性洪灾，造成至少1400人死亡。沙阿呼吁三国共享卫星数据并协调应急预警，以保护喜马拉雅生态系统及约20亿人口。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/a1eed1dc63cc7a0612096f68f810fb02", "author": "", "timestamp": 0, "hot": 6091382, "url": "https://www.baidu.com/s?wd=%E5%B0%BC%E6%B3%8A%E5%B0%94%EF%BC%9A%E6%83%B3%E6%89%BE%E4%B8%AD%E5%8D%B0%E5%90%88%E4%BD%9C", "mobileUrl": "https://www.baidu.com/s?wd=%E5%B0%BC%E6%B3%8A%E5%B0%94%EF%BC%9A%E6%83%B3%E6%89%BE%E4%B8%AD%E5%8D%B0%E5%90%88%E4%BD%9C"}, {"id": 19, "title": "毛晓彤中秋晚会造型好美", "desc": "9月25日晚，毛晓彤、白宇登上央视中秋晚会的舞台。毛晓彤一袭浅白长裙、编发点缀小花，造型好美。她站在桥上唱着《但愿人长久》，温婉灵动。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8af212b312415c219ebf98bf1b83e7f5", "author": "", "timestamp": 0, "hot": 5983849, "url": "https://www.baidu.com/s?wd=%E6%AF%9B%E6%99%93%E5%BD%A4%E4%B8%AD%E7%A7%8B%E6%99%9A%E4%BC%9A%E9%80%A0%E5%9E%8B%E5%A5%BD%E7%BE%8E", "mobileUrl": "https://www.baidu.com/s?wd=%E6%AF%9B%E6%99%93%E5%BD%A4%E4%B8%AD%E7%A7%8B%E6%99%9A%E4%BC%9A%E9%80%A0%E5%9E%8B%E5%A5%BD%E7%BE%8E"}, {"id": 20, "title": "曼城或被剥夺冠军逐出英超", "desc": "北京时间9月25日，曼城115项财务违规指控中除一项外全部被裁定成立，将被判有罪。目前具体处罚尚未确定，预计曼城将提出上诉，理论处罚包含扣分、剥夺冠军及逐出英超等。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/5ebbb8c6e21f1b61aa0f2e3c06d89d07", "author": "", "timestamp": 0, "hot": 5899925, "url": "https://www.baidu.com/s?wd=%E6%9B%BC%E5%9F%8E%E6%88%96%E8%A2%AB%E5%89%A5%E5%A4%BA%E5%86%A0%E5%86%9B%E9%80%90%E5%87%BA%E8%8B%B1%E8%B6%85", "mobileUrl": "https://www.baidu.com/s?wd=%E6%9B%BC%E5%9F%8E%E6%88%96%E8%A2%AB%E5%89%A5%E5%A4%BA%E5%86%A0%E5%86%9B%E9%80%90%E5%87%BA%E8%8B%B1%E8%B6%85"}, {"id": 21, "title": "女演员王朱悦紧急道歉", "desc": "9月24日，《微微一笑很倾城》更名《一笑倾城》上线，女主贝微微被AI换脸为演员王朱悦，引发争议。王朱悦发文承认本人授权换脸并道歉：“毁了大家心中的角色”。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/2b65cddd5d0fa76cb4a6e35606443831", "author": "", "timestamp": 0, "hot": 5796368, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E6%BC%94%E5%91%98%E7%8E%8B%E6%9C%B1%E6%82%A6%E7%B4%A7%E6%80%A5%E9%81%93%E6%AD%89", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E6%BC%94%E5%91%98%E7%8E%8B%E6%9C%B1%E6%82%A6%E7%B4%A7%E6%80%A5%E9%81%93%E6%AD%89"}, {"id": 22, "title": "路边彼岸花、银杏果别乱碰", "desc": "眼下，杭州、南京等地秋意渐浓，吸引民众“捡秋”。但风险暗藏：石蒜（彼岸花）全株有毒，误食可致神经中毒；银杏果含毒性成分，过量食用或接触可致中毒；秋季野生毒蘑菇亦高发。提醒公众切勿随意采摘食用野花野果与野生蘑菇，以免危及生命。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ecbf510275ab3c6b9edcbbeac1feab23", "author": "", "timestamp": 0, "hot": 5711279, "url": "https://www.baidu.com/s?wd=%E8%B7%AF%E8%BE%B9%E5%BD%BC%E5%B2%B8%E8%8A%B1%E3%80%81%E9%93%B6%E6%9D%8F%E6%9E%9C%E5%88%AB%E4%B9%B1%E7%A2%B0", "mobileUrl": "https://www.baidu.com/s?wd=%E8%B7%AF%E8%BE%B9%E5%BD%BC%E5%B2%B8%E8%8A%B1%E3%80%81%E9%93%B6%E6%9D%8F%E6%9E%9C%E5%88%AB%E4%B9%B1%E7%A2%B0"}, {"id": 23, "title": "央视boys秋晚合唱燃爆了", "desc": "“永远不回头，不管天有多高。”2026总台秋晚上，康辉、撒贝宁、朱广权、尼格买提再度合体，热血唱响《永远不回头》。央视boys跳出主持身份，极具感染力的演唱惊艳观众，舞台表现收获众多好评。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f1067e1ef42149b83035c9b2d37f7b3b", "author": "", "timestamp": 0, "hot": 5613977, "url": "https://www.baidu.com/s?wd=%E5%A4%AE%E8%A7%86boys%E7%A7%8B%E6%99%9A%E5%90%88%E5%94%B1%E7%87%83%E7%88%86%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A4%AE%E8%A7%86boys%E7%A7%8B%E6%99%9A%E5%90%88%E5%94%B1%E7%87%83%E7%88%86%E4%BA%86"}, {"id": 24, "title": "为什么中秋要在八月十五", "desc": "中秋各类节庆活动多围绕月亮展开，包含祭月、拜月、赏月等，古人的月崇拜是中秋起源之一。“中秋” 最早见于《周礼》，古时本为秋分傍晚祭月，可秋分日期不固定，未必能逢满月，于是慢慢改到离秋分最近的农历八月十五满月之日祭月。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/70404837004fd8dad88c0328a73130b2", "author": "", "timestamp": 0, "hot": 5517797, "url": "https://www.baidu.com/s?wd=%E4%B8%BA%E4%BB%80%E4%B9%88%E4%B8%AD%E7%A7%8B%E8%A6%81%E5%9C%A8%E5%85%AB%E6%9C%88%E5%8D%81%E4%BA%94", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%BA%E4%BB%80%E4%B9%88%E4%B8%AD%E7%A7%8B%E8%A6%81%E5%9C%A8%E5%85%AB%E6%9C%88%E5%8D%81%E4%BA%94"}, {"id": 25, "title": "泰国选手打破苏炳添亚运会纪录", "desc": "9月25日，名古屋亚运会田径赛场迎来男子百米半决赛争夺。在第一组半决赛中，泰国短跑名将布里蓬·汶颂再度上演惊人发挥，继预赛跑出9秒95打开10秒大关之后，半决赛他一骑绝尘，交出9秒91的成绩，刷新由苏炳添创造的亚运会男子百米赛会纪录。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/40dd13ac9d4c0f4215555bb0d3ee49c6", "author": "", "timestamp": 0, "hot": 5413832, "url": "https://www.baidu.com/s?wd=%E6%B3%B0%E5%9B%BD%E9%80%89%E6%89%8B%E6%89%93%E7%A0%B4%E8%8B%8F%E7%82%B3%E6%B7%BB%E4%BA%9A%E8%BF%90%E4%BC%9A%E7%BA%AA%E5%BD%95", "mobileUrl": "https://www.baidu.com/s?wd=%E6%B3%B0%E5%9B%BD%E9%80%89%E6%89%8B%E6%89%93%E7%A0%B4%E8%8B%8F%E7%82%B3%E6%B7%BB%E4%BA%9A%E8%BF%90%E4%BC%9A%E7%BA%AA%E5%BD%95"}, {"id": 26, "title": "中秋都在刷《武林外传》第40集", "desc": "9月20日，饰演佟掌柜的闫妮携手欧豪、彭昱畅献唱《侠客行》。这首《武林外传》片尾曲全网刷屏，网友感慨：佟掌柜没有骗我，20年弹指一挥间，原来这首歌早在20年前就开导着我们。不少网友表示，每年中秋都会重温《武林外传》第40集。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/649c672cd4e2e75cef3e8e67f5f36f9e", "author": "", "timestamp": 0, "hot": 5335126, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E7%A7%8B%E9%83%BD%E5%9C%A8%E5%88%B7%E3%80%8A%E6%AD%A6%E6%9E%97%E5%A4%96%E4%BC%A0%E3%80%8B%E7%AC%AC40%E9%9B%86", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E7%A7%8B%E9%83%BD%E5%9C%A8%E5%88%B7%E3%80%8A%E6%AD%A6%E6%9E%97%E5%A4%96%E4%BC%A0%E3%80%8B%E7%AC%AC40%E9%9B%86"}, {"id": 27, "title": "张远的提词器全是拼音", "desc": "中秋晚会上，歌手张远演唱电影《阿嬷的情书》主题曲《月下煮茶》。歌曲全程使用难度很高的潮汕话，舞台提词器贴心标注潮汕音标，网友感慨这份安排十分用心。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/fa4be7122ccebd72dee489ad9bee9237", "author": "", "timestamp": 0, "hot": 5229332, "url": "https://www.baidu.com/s?wd=%E5%BC%A0%E8%BF%9C%E7%9A%84%E6%8F%90%E8%AF%8D%E5%99%A8%E5%85%A8%E6%98%AF%E6%8B%BC%E9%9F%B3", "mobileUrl": "https://www.baidu.com/s?wd=%E5%BC%A0%E8%BF%9C%E7%9A%84%E6%8F%90%E8%AF%8D%E5%99%A8%E5%85%A8%E6%98%AF%E6%8B%BC%E9%9F%B3"}, {"id": 28, "title": "前TVB花旦唐宁被经纪公司起诉", "desc": "23日，据港媒报道，44岁前TVB花旦唐宁被经纪公司起诉涉嫌违约。起因是其在合约期间私下接工作、改聘经纪人及擅自染发。起诉状披露，唐宁于2022年9月被诊断患重度抑郁症及B型人格特质，曾有多次自残及持刀威胁他人行为。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8670235154caccfb419b724f4985e736", "author": "", "timestamp": 0, "hot": 5125512, "url": "https://www.baidu.com/s?wd=%E5%89%8DTVB%E8%8A%B1%E6%97%A6%E5%94%90%E5%AE%81%E8%A2%AB%E7%BB%8F%E7%BA%AA%E5%85%AC%E5%8F%B8%E8%B5%B7%E8%AF%89", "mobileUrl": "https://www.baidu.com/s?wd=%E5%89%8DTVB%E8%8A%B1%E6%97%A6%E5%94%90%E5%AE%81%E8%A2%AB%E7%BB%8F%E7%BA%AA%E5%85%AC%E5%8F%B8%E8%B5%B7%E8%AF%89"}]}