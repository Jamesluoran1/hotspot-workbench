{"code": 200, "name": "baidu", "title": "百度", "type": "热搜", "params": {"type": {"name": "热搜类别", "type": {"realtime": "热搜", "novel": "小说", "movie": "电影", "teleplay": "电视剧", "car": "汽车", "game": "游戏"}}}, "link": "https://top.baidu.com/board", "total": 30, "fromCache": false, "updateTime": "2026-09-23T00:32:51.813Z", "data": [{"id": 0, "title": "跨越山海续写“鼓岭情缘”", "desc": "近日，习近平主席复信来华参加中美青年交流活动的美国10所高校青年学生，强调中美青年共担时代使命，续写中美民间友好的“鼓岭情缘”。此前，习近平主席曾宣布未来5年邀5万名美青少年来华交流。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/15cd8ca3fe5c2f8841fc6955bc35acff", "author": "", "timestamp": 0, "hot": 7904886, "url": "https://www.baidu.com/s?wd=%E8%B7%A8%E8%B6%8A%E5%B1%B1%E6%B5%B7%E7%BB%AD%E5%86%99%E2%80%9C%E9%BC%93%E5%B2%AD%E6%83%85%E7%BC%98%E2%80%9D", "mobileUrl": "https://www.baidu.com/s?wd=%E8%B7%A8%E8%B6%8A%E5%B1%B1%E6%B5%B7%E7%BB%AD%E5%86%99%E2%80%9C%E9%BC%93%E5%B2%AD%E6%83%85%E7%BC%98%E2%80%9D"}, {"id": 0, "title": "六神花露水 拿在手里像验钞", "desc": "近日，有网友发文表示，其购买的新版包装六神花露水，瓶身有安全线、暗纹、烫金浮雕，戏称：“拿在手里像在验钞”；还有网友用荧光笔照射瓶身标签，发现部分细密纹路在紫外光下呈现荧光效果。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/d49c3e3b6a67b89b97770bf1fd3fa6d5", "author": "", "timestamp": 0, "hot": 7807972, "url": "https://www.baidu.com/s?wd=%E5%85%AD%E7%A5%9E%E8%8A%B1%E9%9C%B2%E6%B0%B4%20%E6%8B%BF%E5%9C%A8%E6%89%8B%E9%87%8C%E5%83%8F%E9%AA%8C%E9%92%9E", "mobileUrl": "https://www.baidu.com/s?wd=%E5%85%AD%E7%A5%9E%E8%8A%B1%E9%9C%B2%E6%B0%B4+%E6%8B%BF%E5%9C%A8%E6%89%8B%E9%87%8C%E5%83%8F%E9%AA%8C%E9%92%9E"}, {"id": 1, "title": "中国女排夺冠！3-0横扫日本", "desc": "9月22日，亚运会女子排球决赛，中国队3-0击败日本队，夺得金牌！在上一届杭州亚运会女子排球决赛中，中国队也是以同样的比分3-0战胜日本队，获得冠军。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/2a79daf05ec40c3a09a4f23cbb234adf", "author": "", "timestamp": 0, "hot": 7713659, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E5%A5%B3%E6%8E%92%E5%A4%BA%E5%86%A0%EF%BC%813-0%E6%A8%AA%E6%89%AB%E6%97%A5%E6%9C%AC", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E5%A5%B3%E6%8E%92%E5%A4%BA%E5%86%A0%EF%BC%813-0%E6%A8%AA%E6%89%AB%E6%97%A5%E6%9C%AC"}, {"id": 2, "title": "5G+6G 生产生活将有哪些变化", "desc": "刚刚公布的《信息通信行业发展“十五五”规划》明确，到“十五五”末，每万人拥有5G（含5G-A）基站数从2025年的34个增加到2030年的50个，同时提出加快6G核心技术研发攻关，持续开展6G技术试验，适时启动6G商用。5G与6G携手，将使咱们的生产生活再上新台阶。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/6e6c115d0360ee50b6d37a93e3bc6ded", "author": "", "timestamp": 0, "hot": 7618044, "url": "https://www.baidu.com/s?wd=5G%2B6G%20%E7%94%9F%E4%BA%A7%E7%94%9F%E6%B4%BB%E5%B0%86%E6%9C%89%E5%93%AA%E4%BA%9B%E5%8F%98%E5%8C%96", "mobileUrl": "https://www.baidu.com/s?wd=5G%2B6G+%E7%94%9F%E4%BA%A7%E7%94%9F%E6%B4%BB%E5%B0%86%E6%9C%89%E5%93%AA%E4%BA%9B%E5%8F%98%E5%8C%96"}, {"id": 3, "title": "“China Haul”火了", "desc": "最近，海外社交平台“China Haul”（中国购物开箱）火了，外国游客带空行李箱来中国满载国货而归。此前外国游客多关注长城、故宫等符号，如今认识中国的方式正变得更具体。这背后是中国制造品质提升及入境、支付、退税体验的顺畅，促使越来越多外国人“用钱包投票”感受真实的中国。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/008011739af7cd7f0234d6206d3d0c10", "author": "", "timestamp": 0, "hot": 7523333, "url": "https://www.baidu.com/s?wd=%E2%80%9CChina%20Haul%E2%80%9D%E7%81%AB%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9CChina+Haul%E2%80%9D%E7%81%AB%E4%BA%86"}, {"id": 4, "title": "马斯克建议有时间一定要去中国", "desc": "近日，马斯克在央视财经专访中建议，只要时间允许一定要去中国看看。此前他曾乘高铁从北京到西安，体验特别棒，称赞高铁站非常壮观、沿途风光美不胜收，并感叹兵马俑是世界奇迹之一，用语言难以形容中国太棒了。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/69a5599f20148402eaf02d5e15d51a43", "author": "", "timestamp": 0, "hot": 7424098, "url": "https://www.baidu.com/s?wd=%E9%A9%AC%E6%96%AF%E5%85%8B%E5%BB%BA%E8%AE%AE%E6%9C%89%E6%97%B6%E9%97%B4%E4%B8%80%E5%AE%9A%E8%A6%81%E5%8E%BB%E4%B8%AD%E5%9B%BD", "mobileUrl": "https://www.baidu.com/s?wd=%E9%A9%AC%E6%96%AF%E5%85%8B%E5%BB%BA%E8%AE%AE%E6%9C%89%E6%97%B6%E9%97%B4%E4%B8%80%E5%AE%9A%E8%A6%81%E5%8E%BB%E4%B8%AD%E5%9B%BD"}, {"id": 5, "title": "11岁男孩一口流利英语帮邻居谈下大单", "desc": "近日，义乌11岁男孩吉米一口流利英语帮邻居夜市与外国顾客交流，成功谈下大单。他6岁起学英语，已坚持输出4500多次。此前，他曾在国家会议中心全英文介绍家乡义乌，展现出从容自信与商业头脑。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/6d24c9f1a6e0dc52747522f265993eaf", "author": "", "timestamp": 0, "hot": 7329993, "url": "https://www.baidu.com/s?wd=11%E5%B2%81%E7%94%B7%E5%AD%A9%E4%B8%80%E5%8F%A3%E6%B5%81%E5%88%A9%E8%8B%B1%E8%AF%AD%E5%B8%AE%E9%82%BB%E5%B1%85%E8%B0%88%E4%B8%8B%E5%A4%A7%E5%8D%95", "mobileUrl": "https://www.baidu.com/s?wd=11%E5%B2%81%E7%94%B7%E5%AD%A9%E4%B8%80%E5%8F%A3%E6%B5%81%E5%88%A9%E8%8B%B1%E8%AF%AD%E5%B8%AE%E9%82%BB%E5%B1%85%E8%B0%88%E4%B8%8B%E5%A4%A7%E5%8D%95"}, {"id": 6, "title": "日本人身高不及中韩 日媒列3大原因", "desc": "近日，日本媒体总结出日本人身高不及中韩的三大原因：一是少食文化导致每日热量摄入偏低且饮食结构单一；二是严苛的孕妇增重标准导致低体重新生儿占比偏高；三是婴幼儿睡眠时间更短影响生长发育。2019年数据显示日本19岁男女平均身高显著低于中国和韩国水平。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/0ce7b4e98fea14a6cd623dba0dd52b39", "author": "", "timestamp": 0, "hot": 7238130, "url": "https://www.baidu.com/s?wd=%E6%97%A5%E6%9C%AC%E4%BA%BA%E8%BA%AB%E9%AB%98%E4%B8%8D%E5%8F%8A%E4%B8%AD%E9%9F%A9%20%E6%97%A5%E5%AA%92%E5%88%973%E5%A4%A7%E5%8E%9F%E5%9B%A0", "mobileUrl": "https://www.baidu.com/s?wd=%E6%97%A5%E6%9C%AC%E4%BA%BA%E8%BA%AB%E9%AB%98%E4%B8%8D%E5%8F%8A%E4%B8%AD%E9%9F%A9+%E6%97%A5%E5%AA%92%E5%88%973%E5%A4%A7%E5%8E%9F%E5%9B%A0"}, {"id": 7, "title": "多家银行存款利息涨了", "desc": "9月以来，多家中小银行逆势上调存款利率，与当前普遍降息背景形成反差。例如，微众银行App9月21日存款挂牌利率表显示，该行3年期定存利率为1.75%，较之前上调15个基点；湖北监利农商银行、广东五华惠民村镇银行等中小型银行也调整了大额存单、长期定期存款利率。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f1dc150e2ae8ed610fad639059efa3a9", "author": "", "timestamp": 0, "hot": 7135601, "url": "https://www.baidu.com/s?wd=%E5%A4%9A%E5%AE%B6%E9%93%B6%E8%A1%8C%E5%AD%98%E6%AC%BE%E5%88%A9%E6%81%AF%E6%B6%A8%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A4%9A%E5%AE%B6%E9%93%B6%E8%A1%8C%E5%AD%98%E6%AC%BE%E5%88%A9%E6%81%AF%E6%B6%A8%E4%BA%86"}, {"id": 8, "title": "中国发现超大型铜金矿", "desc": "9月22日，国新办发布会介绍，今年1至8月国内油气新增储量可观，安徽茶亭铜金矿、贵州猪拱塘铅锌矿探明为超大型矿床。“十五五”将推进新一轮找矿突破行动，保障战略性矿产供应链安全。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/e4af8f352bd4795fdb20d32b66a6b8a9", "author": "", "timestamp": 0, "hot": 7048379, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E5%8F%91%E7%8E%B0%E8%B6%85%E5%A4%A7%E5%9E%8B%E9%93%9C%E9%87%91%E7%9F%BF", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E5%8F%91%E7%8E%B0%E8%B6%85%E5%A4%A7%E5%9E%8B%E9%93%9C%E9%87%91%E7%9F%BF"}, {"id": 9, "title": "今日秋分", "desc": "9月23日，迎来了秋分节气。中国气象局表示，近期冷空气活动较为频繁但整体强度偏弱，北方多地气温将在波动中逐步下行。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/e35d249545e585003bedff729bd3b715", "author": "", "timestamp": 0, "hot": 6949709, "url": "https://www.baidu.com/s?wd=%E4%BB%8A%E6%97%A5%E7%A7%8B%E5%88%86", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BB%8A%E6%97%A5%E7%A7%8B%E5%88%86"}, {"id": 10, "title": "编造“创始人不喝自家饮料”被拘", "desc": "近日，广东开展涉企网络造谣专项整治，公布典型案例。深圳罗某某编造饮料企业相关虚假文章，已被依法刑事拘留。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/d7c3a6f0e3b9bbe0b84f121e99d1bc7b", "author": "", "timestamp": 0, "hot": 6850305, "url": "https://www.baidu.com/s?wd=%E7%BC%96%E9%80%A0%E2%80%9C%E5%88%9B%E5%A7%8B%E4%BA%BA%E4%B8%8D%E5%96%9D%E8%87%AA%E5%AE%B6%E9%A5%AE%E6%96%99%E2%80%9D%E8%A2%AB%E6%8B%98", "mobileUrl": "https://www.baidu.com/s?wd=%E7%BC%96%E9%80%A0%E2%80%9C%E5%88%9B%E5%A7%8B%E4%BA%BA%E4%B8%8D%E5%96%9D%E8%87%AA%E5%AE%B6%E9%A5%AE%E6%96%99%E2%80%9D%E8%A2%AB%E6%8B%98"}, {"id": 11, "title": "交警隔空怒吼救下一家三口", "desc": "近日，合肥交警隔空怒吼指导故障车乘员避险。事发时，车辆在高速路上无法移动，乘员翻至护栏外后欲返回拿小孩外套。交警急呼“你要不要命了”制止其危险行为，并指导其往前走，避免被撞风险。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/5da7aef1b92d11441abca10699543d0d", "author": "", "timestamp": 0, "hot": 6762340, "url": "https://www.baidu.com/s?wd=%E4%BA%A4%E8%AD%A6%E9%9A%94%E7%A9%BA%E6%80%92%E5%90%BC%E6%95%91%E4%B8%8B%E4%B8%80%E5%AE%B6%E4%B8%89%E5%8F%A3", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BA%A4%E8%AD%A6%E9%9A%94%E7%A9%BA%E6%80%92%E5%90%BC%E6%95%91%E4%B8%8B%E4%B8%80%E5%AE%B6%E4%B8%89%E5%8F%A3"}, {"id": 12, "title": "中国首批航天员已全部停航停训", "desc": "9月21日，杨利伟在国务院新闻办公室举行的中外记者见面会上透露，其与我国首批航天员已于2025年10月停航停训，目前从事选拔训练等技术工作。我国载人航天工程于34年前的9月21日立项，首批14名航天员中9人曾执行飞行任务。目前第二批航天员已成中坚力量。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/250389a39bb731e466342fd00e565e8b", "author": "", "timestamp": 0, "hot": 6663979, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E9%A6%96%E6%89%B9%E8%88%AA%E5%A4%A9%E5%91%98%E5%B7%B2%E5%85%A8%E9%83%A8%E5%81%9C%E8%88%AA%E5%81%9C%E8%AE%AD", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E9%A6%96%E6%89%B9%E8%88%AA%E5%A4%A9%E5%91%98%E5%B7%B2%E5%85%A8%E9%83%A8%E5%81%9C%E8%88%AA%E5%81%9C%E8%AE%AD"}, {"id": 13, "title": "男子称因超龄被当赠品卖进电诈园区", "desc": "四川绵竹38岁男子刘修洪赴泰国收货款时遭绑架，被掳至缅甸电诈园区，被困79天。因年龄大不好售卖，他被当作赠品搭售，凭借中医技能少受打骂，最终由姐姐花费三十多万元将其营救回国。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/47f3e87db8fb637efecdc7893e1994c7", "author": "", "timestamp": 0, "hot": 6563121, "url": "https://www.baidu.com/s?wd=%E7%94%B7%E5%AD%90%E7%A7%B0%E5%9B%A0%E8%B6%85%E9%BE%84%E8%A2%AB%E5%BD%93%E8%B5%A0%E5%93%81%E5%8D%96%E8%BF%9B%E7%94%B5%E8%AF%88%E5%9B%AD%E5%8C%BA", "mobileUrl": "https://www.baidu.com/s?wd=%E7%94%B7%E5%AD%90%E7%A7%B0%E5%9B%A0%E8%B6%85%E9%BE%84%E8%A2%AB%E5%BD%93%E8%B5%A0%E5%93%81%E5%8D%96%E8%BF%9B%E7%94%B5%E8%AF%88%E5%9B%AD%E5%8C%BA"}, {"id": 14, "title": "伊朗外长与美特使在纽约会晤", "desc": "", "cover": "https://fyb-1.cdn.bcebos.com/fyb/de6163834f53ca92c1273fff98ac9078.jpeg", "author": "", "timestamp": 0, "hot": 6465321, "url": "https://www.baidu.com/s?wd=%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF%E4%B8%8E%E7%BE%8E%E7%89%B9%E4%BD%BF%E5%9C%A8%E7%BA%BD%E7%BA%A6%E4%BC%9A%E6%99%A4", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BC%8A%E6%9C%97%E5%A4%96%E9%95%BF%E4%B8%8E%E7%BE%8E%E7%89%B9%E4%BD%BF%E5%9C%A8%E7%BA%BD%E7%BA%A6%E4%BC%9A%E6%99%A4"}, {"id": 15, "title": "GPT-6 Sol和Luna发布 API价格降一半", "desc": "近日，OpenAI发布GPT-6 Sol和Luna模型，将Astra级的高性能引入更快且更经济的模型中。两款新模型在编程及事实可靠性等方面表现优异，API价格相比前代降低50%，目前已面向多类用户开放。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/f9074d087dfa5c7b428d83b9fe80b77a", "author": "", "timestamp": 0, "hot": 6367760, "url": "https://www.baidu.com/s?wd=GPT-6%20Sol%E5%92%8CLuna%E5%8F%91%E5%B8%83%20API%E4%BB%B7%E6%A0%BC%E9%99%8D%E4%B8%80%E5%8D%8A", "mobileUrl": "https://www.baidu.com/s?wd=GPT-6+Sol%E5%92%8CLuna%E5%8F%91%E5%B8%83+API%E4%BB%B7%E6%A0%BC%E9%99%8D%E4%B8%80%E5%8D%8A"}, {"id": 16, "title": "朱广权 秋天的秋到底是什么秋", "desc": "9月23日是秋分，朱广权用古诗词解读秋天的“秋”字内涵。不同的人爱不同的秋，秋沉心底是离人心上秋，一叶落知天下秋，秋风徐徐是天凉好个秋，秋遇到口是长空雁过声啾啾，秋旁有目是烟淡烟浓远近秋。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/39bc2277f35116248e37bccb6209c344", "author": "", "timestamp": 0, "hot": 6284460, "url": "https://www.baidu.com/s?wd=%E6%9C%B1%E5%B9%BF%E6%9D%83%20%E7%A7%8B%E5%A4%A9%E7%9A%84%E7%A7%8B%E5%88%B0%E5%BA%95%E6%98%AF%E4%BB%80%E4%B9%88%E7%A7%8B", "mobileUrl": "https://www.baidu.com/s?wd=%E6%9C%B1%E5%B9%BF%E6%9D%83+%E7%A7%8B%E5%A4%A9%E7%9A%84%E7%A7%8B%E5%88%B0%E5%BA%95%E6%98%AF%E4%BB%80%E4%B9%88%E7%A7%8B"}, {"id": 17, "title": "安徽小学生草丛里捡到一堆钱", "desc": "近日，安徽小学生在草丛捡到一堆钱后立即报警，经现场清点，有现金九千余元。事后，民警在广大师生面前对这种拾金不昧的行为进行表扬。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/72b1aaf73c79b884ed8525809995bd4f", "author": "", "timestamp": 0, "hot": 6179295, "url": "https://www.baidu.com/s?wd=%E5%AE%89%E5%BE%BD%E5%B0%8F%E5%AD%A6%E7%94%9F%E8%8D%89%E4%B8%9B%E9%87%8C%E6%8D%A1%E5%88%B0%E4%B8%80%E5%A0%86%E9%92%B1", "mobileUrl": "https://www.baidu.com/s?wd=%E5%AE%89%E5%BE%BD%E5%B0%8F%E5%AD%A6%E7%94%9F%E8%8D%89%E4%B8%9B%E9%87%8C%E6%8D%A1%E5%88%B0%E4%B8%80%E5%A0%86%E9%92%B1"}, {"id": 18, "title": "清淡饮食也会胖吗", "desc": "针对“清淡饮食还发胖”的疑惑，专家科普日常饮食中存在“隐形刺客”——“隐形”的油、盐、糖，指导公众学会识别这些隐形刺客，轻松将“三减”融入日常健康吃法中。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/7cf9506b2c32b00d88cbce9e12420858", "author": "", "timestamp": 0, "hot": 6081869, "url": "https://www.baidu.com/s?wd=%E6%B8%85%E6%B7%A1%E9%A5%AE%E9%A3%9F%E4%B9%9F%E4%BC%9A%E8%83%96%E5%90%97", "mobileUrl": "https://www.baidu.com/s?wd=%E6%B8%85%E6%B7%A1%E9%A5%AE%E9%A3%9F%E4%B9%9F%E4%BC%9A%E8%83%96%E5%90%97"}, {"id": 19, "title": "开车千万别穿洞洞鞋", "desc": "9月20日，重庆网友分享穿洞洞鞋开车撞花坛的经历，虽拉起鞋后跟仍存在隐患。江苏张女士也曾因厚底洞洞鞋卡在油门刹车之间，车辆失控撞立柱，车头受损，她提醒大家以此为戒。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/c4724a2c3d594dbf0076a4e54e844574", "author": "", "timestamp": 0, "hot": 5988318, "url": "https://www.baidu.com/s?wd=%E5%BC%80%E8%BD%A6%E5%8D%83%E4%B8%87%E5%88%AB%E7%A9%BF%E6%B4%9E%E6%B4%9E%E9%9E%8B", "mobileUrl": "https://www.baidu.com/s?wd=%E5%BC%80%E8%BD%A6%E5%8D%83%E4%B8%87%E5%88%AB%E7%A9%BF%E6%B4%9E%E6%B4%9E%E9%9E%8B"}, {"id": 20, "title": "女子花3.9万相亲54岁男子实际63岁", "desc": "近日，北京三中院审结一起婚恋服务合同纠纷案。2024年，崔女士花3.9万元委托婚介公司相亲。此前，婚介为其推荐资料标注54岁的“优质男”，崔女士接触后发现对方实际63岁且信息存疑。崔女士退费无果诉至法院，最终判决婚介公司退还崔女士3万元。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b5cc8e5e0833631d345b0b29d66f2f2a", "author": "", "timestamp": 0, "hot": 5901350, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E8%8A%B13.9%E4%B8%87%E7%9B%B8%E4%BA%B254%E5%B2%81%E7%94%B7%E5%AD%90%E5%AE%9E%E9%99%8563%E5%B2%81", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%90%E8%8A%B13.9%E4%B8%87%E7%9B%B8%E4%BA%B254%E5%B2%81%E7%94%B7%E5%AD%90%E5%AE%9E%E9%99%8563%E5%B2%81"}, {"id": 21, "title": "潘玮柏自曝病情 公开感谢王心凌", "desc": "9月19日，潘玮柏在演出时自曝病情，公开感谢王心凌及时发现异常“救命”。此前今年5月两人聚餐时，王心凌察觉潘玮柏频繁眨眼异常，坚持提醒其就医，潘玮柏才紧急就医，确诊轻微面瘫。潘玮柏感慨幸好未耽误治疗，并提醒大家注意休息。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/48a47ce8d22f650e57616e53c1c04b76", "author": "", "timestamp": 0, "hot": 5803782, "url": "https://www.baidu.com/s?wd=%E6%BD%98%E7%8E%AE%E6%9F%8F%E8%87%AA%E6%9B%9D%E7%97%85%E6%83%85%20%E5%85%AC%E5%BC%80%E6%84%9F%E8%B0%A2%E7%8E%8B%E5%BF%83%E5%87%8C", "mobileUrl": "https://www.baidu.com/s?wd=%E6%BD%98%E7%8E%AE%E6%9F%8F%E8%87%AA%E6%9B%9D%E7%97%85%E6%83%85+%E5%85%AC%E5%BC%80%E6%84%9F%E8%B0%A2%E7%8E%8B%E5%BF%83%E5%87%8C"}, {"id": 22, "title": "多地网友反映养犬35cm限高标准过低", "desc": "今年以来，四川多地接连有网友反映禁养肩高35厘米以上犬只的标准过低。有网友指出，采用肩高35厘米“一刀切”标准划定禁养犬，对“烈性犬”划分来源太落后。“一刀切”限制中、大型温顺伴侣犬，会压制本地宠物消费、就业的发展空间。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/bf602589d13221ea30fc6c4a39439e0e", "author": "", "timestamp": 0, "hot": 5710099, "url": "https://www.baidu.com/s?wd=%E5%A4%9A%E5%9C%B0%E7%BD%91%E5%8F%8B%E5%8F%8D%E6%98%A0%E5%85%BB%E7%8A%AC35cm%E9%99%90%E9%AB%98%E6%A0%87%E5%87%86%E8%BF%87%E4%BD%8E", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A4%9A%E5%9C%B0%E7%BD%91%E5%8F%8B%E5%8F%8D%E6%98%A0%E5%85%BB%E7%8A%AC35cm%E9%99%90%E9%AB%98%E6%A0%87%E5%87%86%E8%BF%87%E4%BD%8E"}, {"id": 23, "title": "日本“台积电之城”变“鬼城”", "desc": "台积电自从决定进军日本市场后，日本熊本县菊阳町地价便一路飙升，许多不动产公司看好投资与自住需求，纷纷开发建造公寓。不过近期有熊本县当地房产中介表示，大楼与旅馆如雨后春笋般林立，但到了晚上却很少有灯亮着，“宛如鬼城无人居住”。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/30d9394546b3728cf6314dbc178c05b3", "author": "", "timestamp": 0, "hot": 5604369, "url": "https://www.baidu.com/s?wd=%E6%97%A5%E6%9C%AC%E2%80%9C%E5%8F%B0%E7%A7%AF%E7%94%B5%E4%B9%8B%E5%9F%8E%E2%80%9D%E5%8F%98%E2%80%9C%E9%AC%BC%E5%9F%8E%E2%80%9D", "mobileUrl": "https://www.baidu.com/s?wd=%E6%97%A5%E6%9C%AC%E2%80%9C%E5%8F%B0%E7%A7%AF%E7%94%B5%E4%B9%8B%E5%9F%8E%E2%80%9D%E5%8F%98%E2%80%9C%E9%AC%BC%E5%9F%8E%E2%80%9D"}, {"id": 24, "title": "前妻死亡 男子领98万赔偿款未果上诉", "desc": "2024年11月湖南桑植一民房因废旧锂电池起火，造成7人遇难。死者前夫余某想要领取前妻98万余元垫付赔偿款遭拒，起诉镇政府。近日，张家界中院二审认定镇政府只是垫付方，驳回了余某的诉讼请求。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/198590dd81cd54e7d44e3a9cc85c4973", "author": "", "timestamp": 0, "hot": 5526387, "url": "https://www.baidu.com/s?wd=%E5%89%8D%E5%A6%BB%E6%AD%BB%E4%BA%A1%20%E7%94%B7%E5%AD%90%E9%A2%8698%E4%B8%87%E8%B5%94%E5%81%BF%E6%AC%BE%E6%9C%AA%E6%9E%9C%E4%B8%8A%E8%AF%89", "mobileUrl": "https://www.baidu.com/s?wd=%E5%89%8D%E5%A6%BB%E6%AD%BB%E4%BA%A1+%E7%94%B7%E5%AD%90%E9%A2%8698%E4%B8%87%E8%B5%94%E5%81%BF%E6%AC%BE%E6%9C%AA%E6%9E%9C%E4%B8%8A%E8%AF%89"}, {"id": 25, "title": "女孩遇争执报警 是否浪费警力引热议", "desc": "近日，上海一名8岁女孩玩耍时被男孩推倒，用电话手表拨打110报警。民警到场安抚女孩、查看伤情，面对“浪费警力”的质疑，民警表示报警并非浪费警力，随后批评教育男孩，女孩家长选择不予追究。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/2660b825269f247df267dec5f8d6f702", "author": "", "timestamp": 0, "hot": 5429989, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%A9%E9%81%87%E4%BA%89%E6%89%A7%E6%8A%A5%E8%AD%A6%20%E6%98%AF%E5%90%A6%E6%B5%AA%E8%B4%B9%E8%AD%A6%E5%8A%9B%E5%BC%95%E7%83%AD%E8%AE%AE", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%AD%A9%E9%81%87%E4%BA%89%E6%89%A7%E6%8A%A5%E8%AD%A6+%E6%98%AF%E5%90%A6%E6%B5%AA%E8%B4%B9%E8%AD%A6%E5%8A%9B%E5%BC%95%E7%83%AD%E8%AE%AE"}, {"id": 26, "title": "95后对月饼兴趣不高", "desc": "9月22日，记者实探武汉商超发现，美心流心奶黄月饼价格从320元两连降至268元。此前“月饼卖不动”词条冲上热搜。数据显示，8月14日至9月13日主要门店月饼销售额同比下滑45.17%，95后对月饼兴趣不高，市场整体遇冷。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/5655bc9ac0c2b5e6e6787a372d1f658e", "author": "", "timestamp": 0, "hot": 5336685, "url": "https://www.baidu.com/s?wd=95%E5%90%8E%E5%AF%B9%E6%9C%88%E9%A5%BC%E5%85%B4%E8%B6%A3%E4%B8%8D%E9%AB%98", "mobileUrl": "https://www.baidu.com/s?wd=95%E5%90%8E%E5%AF%B9%E6%9C%88%E9%A5%BC%E5%85%B4%E8%B6%A3%E4%B8%8D%E9%AB%98"}, {"id": 27, "title": "中国女排十冠王", "desc": "9月22日，在日本名古屋举行的爱知·名古屋亚运会女子排球决赛中，中国女排以3:0战胜东道主日本女排。中国女排队史第十次夺得亚运会冠军，成就亚运“十冠王”。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/70571fc51f9c2958e7bd473c158bad03", "author": "", "timestamp": 0, "hot": 5238162, "url": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E5%A5%B3%E6%8E%92%E5%8D%81%E5%86%A0%E7%8E%8B", "mobileUrl": "https://www.baidu.com/s?wd=%E4%B8%AD%E5%9B%BD%E5%A5%B3%E6%8E%92%E5%8D%81%E5%86%A0%E7%8E%8B"}, {"id": 28, "title": "新任甘肃省委书记表态", "desc": "9月22日下午，甘肃全省领导干部会议在兰州召开，中央组织部副部长齐家滨宣布中央决定：吴晓军任甘肃省委书记，胡昌升不再担任该职务。吴晓军表态，完全拥护、坚决服从党中央决定，感谢党中央的信任厚爱。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/1cdaeb0818e564a1b87f78588a5511a4", "author": "", "timestamp": 0, "hot": 5140441, "url": "https://www.baidu.com/s?wd=%E6%96%B0%E4%BB%BB%E7%94%98%E8%82%83%E7%9C%81%E5%A7%94%E4%B9%A6%E8%AE%B0%E8%A1%A8%E6%80%81", "mobileUrl": "https://www.baidu.com/s?wd=%E6%96%B0%E4%BB%BB%E7%94%98%E8%82%83%E7%9C%81%E5%A7%94%E4%B9%A6%E8%AE%B0%E8%A1%A8%E6%80%81"}]}