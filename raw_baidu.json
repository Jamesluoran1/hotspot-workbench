{"code": 200, "name": "baidu", "title": "百度", "type": "热搜", "params": {"type": {"name": "热搜类别", "type": {"realtime": "热搜", "novel": "小说", "movie": "电影", "teleplay": "电视剧", "car": "汽车", "game": "游戏"}}}, "link": "https://top.baidu.com/board", "total": 30, "fromCache": true, "updateTime": "2026-09-15T04:15:23.571Z", "data": [{"id": 0, "title": "勇做时代先锋 汇聚团结力量", "desc": "9月12日至13日，应印度总理莫迪邀请，习近平主席赴新德里出席金砖国家领导人第十八次会晤。金砖合作砥砺前行二十载，这是对“大金砖合作”历史使命的明确指引：“坚定站在历史正确一边，勇做时代先锋，引领国际秩序朝着更加公正合理的方向发展，携手推动构建人类命运共同体。”", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/713838b48dc8f8c54a8636c9479cfa65", "author": "", "timestamp": 0, "hot": 7904166, "url": "https://www.baidu.com/s?wd=%E5%8B%87%E5%81%9A%E6%97%B6%E4%BB%A3%E5%85%88%E9%94%8B%20%E6%B1%87%E8%81%9A%E5%9B%A2%E7%BB%93%E5%8A%9B%E9%87%8F", "mobileUrl": "https://www.baidu.com/s?wd=%E5%8B%87%E5%81%9A%E6%97%B6%E4%BB%A3%E5%85%88%E9%94%8B+%E6%B1%87%E8%81%9A%E5%9B%A2%E7%BB%93%E5%8A%9B%E9%87%8F"}, {"id": 0, "title": "电池税正式落地对新能源车意味着什么", "desc": "今年9月1日起，中国锂电池行业结束十余年免征，按2%税率征收消费税，明年9月1日升至4%，新增成本约1200至3000元。新能源车普涨概率低，行业将加速向头部集中，产业从政策驱动转向市场驱动。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ef77fadd68c08699249915a355aa2f2c", "author": "", "timestamp": 0, "hot": 7808001, "url": "https://www.baidu.com/s?wd=%E7%94%B5%E6%B1%A0%E7%A8%8E%E6%AD%A3%E5%BC%8F%E8%90%BD%E5%9C%B0%E5%AF%B9%E6%96%B0%E8%83%BD%E6%BA%90%E8%BD%A6%E6%84%8F%E5%91%B3%E7%9D%80%E4%BB%80%E4%B9%88", "mobileUrl": "https://www.baidu.com/s?wd=%E7%94%B5%E6%B1%A0%E7%A8%8E%E6%AD%A3%E5%BC%8F%E8%90%BD%E5%9C%B0%E5%AF%B9%E6%96%B0%E8%83%BD%E6%BA%90%E8%BD%A6%E6%84%8F%E5%91%B3%E7%9D%80%E4%BB%80%E4%B9%88"}, {"id": 1, "title": "塔克拉玛干沙漠发现大型水源", "desc": "近日，由新疆地质局水文环境地质调查中心实施的南疆沙漠找水项目取得新突破，在塔克拉玛干沙漠南缘的民丰县安迪尔乡和沙漠腹地的麻扎塔格山南区域新发现两处大型地下水水源，打破了“沙漠地下只有死水、咸水”的传统认知。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/b340738a49ccb8a4a0bb289c5cc3cdd8", "author": "", "timestamp": 0, "hot": 7714220, "url": "https://www.baidu.com/s?wd=%E5%A1%94%E5%85%8B%E6%8B%89%E7%8E%9B%E5%B9%B2%E6%B2%99%E6%BC%A0%E5%8F%91%E7%8E%B0%E5%A4%A7%E5%9E%8B%E6%B0%B4%E6%BA%90", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A1%94%E5%85%8B%E6%8B%89%E7%8E%9B%E5%B9%B2%E6%B2%99%E6%BC%A0%E5%8F%91%E7%8E%B0%E5%A4%A7%E5%9E%8B%E6%B0%B4%E6%BA%90"}, {"id": 2, "title": "外籍游客爱上中国秋日深度游", "desc": "暑期落幕，秋景上线！避开暑期拥堵、赶上政策红利，大批外籍游客选择九月错峰来华，沉浸式感受秋日中国的山水风光与人文魅力，入境旅游持续升温。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/7587506b7887b546f38e3f821506a28f", "author": "", "timestamp": 0, "hot": 7617401, "url": "https://www.baidu.com/s?wd=%E5%A4%96%E7%B1%8D%E6%B8%B8%E5%AE%A2%E7%88%B1%E4%B8%8A%E4%B8%AD%E5%9B%BD%E7%A7%8B%E6%97%A5%E6%B7%B1%E5%BA%A6%E6%B8%B8", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A4%96%E7%B1%8D%E6%B8%B8%E5%AE%A2%E7%88%B1%E4%B8%8A%E4%B8%AD%E5%9B%BD%E7%A7%8B%E6%97%A5%E6%B7%B1%E5%BA%A6%E6%B8%B8"}, {"id": 3, "title": "演唱会求婚当事人称已报警", "desc": "9月12日，北京鸟巢赵雷演唱会现场，一对情侣因求婚时女方激动站起，遭后排观众齐声高喊“坐下”。拍摄该视频的观众表示，自己花大几千元购票只想安静听歌。目前，当事人已私信拍摄者称报警并启动司法程序，要求下架相关视频。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/1c20e6f3a785d726fc84ebf7f398facc", "author": "", "timestamp": 0, "hot": 7520135, "url": "https://www.baidu.com/s?wd=%E6%BC%94%E5%94%B1%E4%BC%9A%E6%B1%82%E5%A9%9A%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%A7%B0%E5%B7%B2%E6%8A%A5%E8%AD%A6", "mobileUrl": "https://www.baidu.com/s?wd=%E6%BC%94%E5%94%B1%E4%BC%9A%E6%B1%82%E5%A9%9A%E5%BD%93%E4%BA%8B%E4%BA%BA%E7%A7%B0%E5%B7%B2%E6%8A%A5%E8%AD%A6"}, {"id": 4, "title": "本科生扎堆回炉读技校", "desc": "8‑9月多地开设大学生技师班，大批高校毕业生回炉进修技能。各地通过校企协同办学，学员可考取技师证书，享受相关人才政策。专家建议高校深化产教融合，优化专业设置，提升人才培养与产业岗位的匹配度。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/66023a115ac3f8965a2b93e1e60c2480", "author": "", "timestamp": 0, "hot": 7426105, "url": "https://www.baidu.com/s?wd=%E6%9C%AC%E7%A7%91%E7%94%9F%E6%89%8E%E5%A0%86%E5%9B%9E%E7%82%89%E8%AF%BB%E6%8A%80%E6%A0%A1", "mobileUrl": "https://www.baidu.com/s?wd=%E6%9C%AC%E7%A7%91%E7%94%9F%E6%89%8E%E5%A0%86%E5%9B%9E%E7%82%89%E8%AF%BB%E6%8A%80%E6%A0%A1"}, {"id": 5, "title": "雷军脚踹宇树机器人", "desc": "9月14日，小米集团创始人雷军现身宇树科技，在王兴兴陪同下观看人形机器人表演。现场雷军与人形机器人过招，右脚猛踹机器人，机器人后退几步稳稳站住。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/640a3306076fced509e7c03c4d87c69c", "author": "", "timestamp": 0, "hot": 7333019, "url": "https://www.baidu.com/s?wd=%E9%9B%B7%E5%86%9B%E8%84%9A%E8%B8%B9%E5%AE%87%E6%A0%91%E6%9C%BA%E5%99%A8%E4%BA%BA", "mobileUrl": "https://www.baidu.com/s?wd=%E9%9B%B7%E5%86%9B%E8%84%9A%E8%B8%B9%E5%AE%87%E6%A0%91%E6%9C%BA%E5%99%A8%E4%BA%BA"}, {"id": 6, "title": "女婴身亡月子中心产妇全部搬离", "desc": "8月24日，广州番禺一6天大女婴在暖月月子中心身亡，家属质疑喂奶不当致其窒息。9月14日多部门介入，店内产妇已全部搬离并退费。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/33ec624955bdb586a80c70e0d7b66186", "author": "", "timestamp": 0, "hot": 7235575, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%A9%B4%E8%BA%AB%E4%BA%A1%E6%9C%88%E5%AD%90%E4%B8%AD%E5%BF%83%E4%BA%A7%E5%A6%87%E5%85%A8%E9%83%A8%E6%90%AC%E7%A6%BB", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E5%A9%B4%E8%BA%AB%E4%BA%A1%E6%9C%88%E5%AD%90%E4%B8%AD%E5%BF%83%E4%BA%A7%E5%A6%87%E5%85%A8%E9%83%A8%E6%90%AC%E7%A6%BB"}, {"id": 7, "title": "“四川芬达”恶搞杨坤被判赔31.5万", "desc": "2026年3月，网红“四川芬达”恶搞杨坤一案执行案件立案。当事人表示认同法院认定的全部事实及后果，向杨坤郑重道歉。此前法院判决其赔偿31.5万元，杨坤工作室称将全部捐出。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/abcfeecc674cc2952f5a043da345a321", "author": "", "timestamp": 0, "hot": 7140585, "url": "https://www.baidu.com/s?wd=%E2%80%9C%E5%9B%9B%E5%B7%9D%E8%8A%AC%E8%BE%BE%E2%80%9D%E6%81%B6%E6%90%9E%E6%9D%A8%E5%9D%A4%E8%A2%AB%E5%88%A4%E8%B5%9431.5%E4%B8%87", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9C%E5%9B%9B%E5%B7%9D%E8%8A%AC%E8%BE%BE%E2%80%9D%E6%81%B6%E6%90%9E%E6%9D%A8%E5%9D%A4%E8%A2%AB%E5%88%A4%E8%B5%9431.5%E4%B8%87"}, {"id": 8, "title": "烧烤店主：文旅局的回复没法听", "desc": "2026年6月底，菏泽一烧烤店店主张先生实名举报，当地元代古沉船考古中一件元青花杯疑似遗失。菏泽烧烤店主最新发声：文旅局的回复简直没法听，考古专家认定那不是一件完整的器物。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/7d1a20c035e8654515494697d8133579", "author": "", "timestamp": 0, "hot": 7044248, "url": "https://www.baidu.com/s?wd=%E7%83%A7%E7%83%A4%E5%BA%97%E4%B8%BB%EF%BC%9A%E6%96%87%E6%97%85%E5%B1%80%E7%9A%84%E5%9B%9E%E5%A4%8D%E6%B2%A1%E6%B3%95%E5%90%AC", "mobileUrl": "https://www.baidu.com/s?wd=%E7%83%A7%E7%83%A4%E5%BA%97%E4%B8%BB%EF%BC%9A%E6%96%87%E6%97%85%E5%B1%80%E7%9A%84%E5%9B%9E%E5%A4%8D%E6%B2%A1%E6%B3%95%E5%90%AC"}, {"id": 9, "title": "“能看海的地铁”试乘首日挤爆了", "desc": "9月14日，宁波轨道交通12号线开展免费试乘。该线是国内首条跨海市域铁路，主城至象山约30分钟可达。首日客流火爆，致小洋江站8时20分许实施限流管控，运营方呼吁暂缓前往，11时许管控取消。试乘活动持续至19日。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/1114fd50038e9c976114a16b7027456b", "author": "", "timestamp": 0, "hot": 6951704, "url": "https://www.baidu.com/s?wd=%E2%80%9C%E8%83%BD%E7%9C%8B%E6%B5%B7%E7%9A%84%E5%9C%B0%E9%93%81%E2%80%9D%E8%AF%95%E4%B9%98%E9%A6%96%E6%97%A5%E6%8C%A4%E7%88%86%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9C%E8%83%BD%E7%9C%8B%E6%B5%B7%E7%9A%84%E5%9C%B0%E9%93%81%E2%80%9D%E8%AF%95%E4%B9%98%E9%A6%96%E6%97%A5%E6%8C%A4%E7%88%86%E4%BA%86"}, {"id": 10, "title": "2026平谷区网络优秀作品展播", "desc": "今年7月，平谷区委网信办联合区教委开展网络举报宣传作品征集活动，共收到作品 142 件，经评选颁奖，凝聚网络治理合力。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/e9193c45705bc20e949bb75f6cbead21", "author": "", "timestamp": 0, "hot": 6850127, "url": "https://www.baidu.com/s?wd=2026%E5%B9%B3%E8%B0%B7%E5%8C%BA%E7%BD%91%E7%BB%9C%E4%BC%98%E7%A7%80%E4%BD%9C%E5%93%81%E5%B1%95%E6%92%AD", "mobileUrl": "https://www.baidu.com/s?wd=2026%E5%B9%B3%E8%B0%B7%E5%8C%BA%E7%BD%91%E7%BB%9C%E4%BC%98%E7%A7%80%E4%BD%9C%E5%93%81%E5%B1%95%E6%92%AD"}, {"id": 11, "title": "四盒没人取的牛奶救人一命", "desc": "近日，江苏无锡一小区保安卢强发现独居老人家中灯亮、四盒牛奶两天未取，且老人久未露面，报警后发现老人突发脑梗倒地。后老人获及时救治转危为安，9月10日卢强获颁证书和奖金。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8ba6c0a350d73f4e2ef38d895e97e1d4", "author": "", "timestamp": 0, "hot": 6763455, "url": "https://www.baidu.com/s?wd=%E5%9B%9B%E7%9B%92%E6%B2%A1%E4%BA%BA%E5%8F%96%E7%9A%84%E7%89%9B%E5%A5%B6%E6%95%91%E4%BA%BA%E4%B8%80%E5%91%BD", "mobileUrl": "https://www.baidu.com/s?wd=%E5%9B%9B%E7%9B%92%E6%B2%A1%E4%BA%BA%E5%8F%96%E7%9A%84%E7%89%9B%E5%A5%B6%E6%95%91%E4%BA%BA%E4%B8%80%E5%91%BD"}, {"id": 12, "title": "“喊坐下都算礼貌 要我就喊离婚”", "desc": "9月12日，赵雷北京鸟巢演唱会上，前排一名男观众突然向女友求婚，女方激动站起，导致后排齐声高喊“坐下”。这段现场视频被发到社交媒体后，此事冲上热搜。更有人表态：“喊坐下都算礼貌，要我就喊离婚。”", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/1b54c00df40217351cbd810d888a0e22", "author": "", "timestamp": 0, "hot": 6664491, "url": "https://www.baidu.com/s?wd=%E2%80%9C%E5%96%8A%E5%9D%90%E4%B8%8B%E9%83%BD%E7%AE%97%E7%A4%BC%E8%B2%8C%20%E8%A6%81%E6%88%91%E5%B0%B1%E5%96%8A%E7%A6%BB%E5%A9%9A%E2%80%9D", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9C%E5%96%8A%E5%9D%90%E4%B8%8B%E9%83%BD%E7%AE%97%E7%A4%BC%E8%B2%8C+%E8%A6%81%E6%88%91%E5%B0%B1%E5%96%8A%E7%A6%BB%E5%A9%9A%E2%80%9D"}, {"id": 13, "title": "伊朗和韩国杠上了", "desc": "9月7日，伊朗外交部警告韩国，任何向波斯湾或霍尔木兹海峡派兵的行为都将被视为支持美国“侵略”。韩国随后表示尚未决定是否派遣军事力量，或仅提供非战斗及搜救支援，双方言辞交锋引发关注。此前，韩国在美国压力下考虑派兵。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/24f35be70da7d46dc7d8bcf6740437cc", "author": "", "timestamp": 0, "hot": 6565631, "url": "https://www.baidu.com/s?wd=%E4%BC%8A%E6%9C%97%E5%92%8C%E9%9F%A9%E5%9B%BD%E6%9D%A0%E4%B8%8A%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E4%BC%8A%E6%9C%97%E5%92%8C%E9%9F%A9%E5%9B%BD%E6%9D%A0%E4%B8%8A%E4%BA%86"}, {"id": 14, "title": "男子在公园钓到大鱼火速逃跑", "desc": "四川成都一男子在公园钓到大鱼后火速逃跑，公园保安在后方狂追。园方回应称公园禁止钓鱼，保安无执法权仅能进行劝导和记录，已将事件移交警方处理。若系多次行为将追究责任。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/7aa9b87868cba478151bc4d16406caf7", "author": "", "timestamp": 0, "hot": 6478227, "url": "https://www.baidu.com/s?wd=%E7%94%B7%E5%AD%90%E5%9C%A8%E5%85%AC%E5%9B%AD%E9%92%93%E5%88%B0%E5%A4%A7%E9%B1%BC%E7%81%AB%E9%80%9F%E9%80%83%E8%B7%91", "mobileUrl": "https://www.baidu.com/s?wd=%E7%94%B7%E5%AD%90%E5%9C%A8%E5%85%AC%E5%9B%AD%E9%92%93%E5%88%B0%E5%A4%A7%E9%B1%BC%E7%81%AB%E9%80%9F%E9%80%83%E8%B7%91"}, {"id": 15, "title": "父亲撞死人让儿子顶包 全家串供", "desc": "", "cover": "https://fyb-1.cdn.bcebos.com/fyb/de6163834f53ca92c1273fff98ac9078.jpeg", "author": "", "timestamp": 0, "hot": 6378712, "url": "https://www.baidu.com/s?wd=%E7%88%B6%E4%BA%B2%E6%92%9E%E6%AD%BB%E4%BA%BA%E8%AE%A9%E5%84%BF%E5%AD%90%E9%A1%B6%E5%8C%85%20%E5%85%A8%E5%AE%B6%E4%B8%B2%E4%BE%9B", "mobileUrl": "https://www.baidu.com/s?wd=%E7%88%B6%E4%BA%B2%E6%92%9E%E6%AD%BB%E4%BA%BA%E8%AE%A9%E5%84%BF%E5%AD%90%E9%A1%B6%E5%8C%85+%E5%85%A8%E5%AE%B6%E4%B8%B2%E4%BE%9B"}, {"id": 16, "title": "浙江省委书记省长带头捐款", "desc": "9月14日下午，浙江省委书记王浩、省长刘捷等省领导参加“慈善一日捐”活动并带头捐款。此前，该活动在浙江已延续多年，自2021年起每年省四套班子领导均带头捐款。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/25ea9c64c5b928a1c918cc6c880a2d7e", "author": "", "timestamp": 0, "hot": 6273053, "url": "https://www.baidu.com/s?wd=%E6%B5%99%E6%B1%9F%E7%9C%81%E5%A7%94%E4%B9%A6%E8%AE%B0%E7%9C%81%E9%95%BF%E5%B8%A6%E5%A4%B4%E6%8D%90%E6%AC%BE", "mobileUrl": "https://www.baidu.com/s?wd=%E6%B5%99%E6%B1%9F%E7%9C%81%E5%A7%94%E4%B9%A6%E8%AE%B0%E7%9C%81%E9%95%BF%E5%B8%A6%E5%A4%B4%E6%8D%90%E6%AC%BE"}, {"id": 17, "title": "新生儿窒息死亡 月子中心：已报警", "desc": "9月14日，广州番禺暖月月子中心就“6天女婴窒息死亡”发声明。此前，李女士称女儿在喂奶时窒息死亡，家属质疑月子中心操作不当且未有效急救。声明称法医鉴定正进行中，死因未定；澄清“强制喂奶致呛奶死”“跑路”“护理人员系实习生”等说法不实；并指部分人员到经营场所滋事毁坏财物，已报警处理。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/d9da368c8ca0251ca81cdf8a6beef075", "author": "", "timestamp": 0, "hot": 6187109, "url": "https://www.baidu.com/s?wd=%E6%96%B0%E7%94%9F%E5%84%BF%E7%AA%92%E6%81%AF%E6%AD%BB%E4%BA%A1%20%E6%9C%88%E5%AD%90%E4%B8%AD%E5%BF%83%EF%BC%9A%E5%B7%B2%E6%8A%A5%E8%AD%A6", "mobileUrl": "https://www.baidu.com/s?wd=%E6%96%B0%E7%94%9F%E5%84%BF%E7%AA%92%E6%81%AF%E6%AD%BB%E4%BA%A1+%E6%9C%88%E5%AD%90%E4%B8%AD%E5%BF%83%EF%BC%9A%E5%B7%B2%E6%8A%A5%E8%AD%A6"}, {"id": 18, "title": "“第一学历”歧视该翻篇了", "desc": "最近，东北农大硕士与北大硕士在求职大厂时，均因“第一学历”不符遭遇拒录或降薪。媒体指出，“第一学历”歧视该翻篇了，应从立法执法层面弥补漏洞，保障平等就业权。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ba015133055e6859cfe2ecd875816f4c", "author": "", "timestamp": 0, "hot": 6078811, "url": "https://www.baidu.com/s?wd=%E2%80%9C%E7%AC%AC%E4%B8%80%E5%AD%A6%E5%8E%86%E2%80%9D%E6%AD%A7%E8%A7%86%E8%AF%A5%E7%BF%BB%E7%AF%87%E4%BA%86", "mobileUrl": "https://www.baidu.com/s?wd=%E2%80%9C%E7%AC%AC%E4%B8%80%E5%AD%A6%E5%8E%86%E2%80%9D%E6%AD%A7%E8%A7%86%E8%AF%A5%E7%BF%BB%E7%AF%87%E4%BA%86"}, {"id": 19, "title": "曝姆巴佩与登贝莱彻底决裂", "desc": "近日，姆巴佩称自己早早被视为“天选之子”，登贝莱则回应称自己一直“坐在教室最后一排，埋头苦练”，引发外界对两人关系的猜测。此前，西班牙记者爆料两人关系彻底决裂，世界杯出局后零交流，齐达内拟紧急面谈调解。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/19af2ebf132bdf18006ce1e7b6d91117", "author": "", "timestamp": 0, "hot": 6000733, "url": "https://www.baidu.com/s?wd=%E6%9B%9D%E5%A7%86%E5%B7%B4%E4%BD%A9%E4%B8%8E%E7%99%BB%E8%B4%9D%E8%8E%B1%E5%BD%BB%E5%BA%95%E5%86%B3%E8%A3%82", "mobileUrl": "https://www.baidu.com/s?wd=%E6%9B%9D%E5%A7%86%E5%B7%B4%E4%BD%A9%E4%B8%8E%E7%99%BB%E8%B4%9D%E8%8E%B1%E5%BD%BB%E5%BA%95%E5%86%B3%E8%A3%82"}, {"id": 20, "title": "特朗普急了 致电黄仁勋斥责AI危险论", "desc": "北京时间9月15日，据彭博社报道，英伟达CEO黄仁勋周一在参加一场小组讨论时，现场接听了美国总统特朗普打来的电话，让特朗普有机会将AI危险论斥为“骗局”。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/2f176781d9c5574b2b54bd87ee5f25f8", "author": "", "timestamp": 0, "hot": 5902722, "url": "https://www.baidu.com/s?wd=%E7%89%B9%E6%9C%97%E6%99%AE%E6%80%A5%E4%BA%86%20%E8%87%B4%E7%94%B5%E9%BB%84%E4%BB%81%E5%8B%8B%E6%96%A5%E8%B4%A3AI%E5%8D%B1%E9%99%A9%E8%AE%BA", "mobileUrl": "https://www.baidu.com/s?wd=%E7%89%B9%E6%9C%97%E6%99%AE%E6%80%A5%E4%BA%86+%E8%87%B4%E7%94%B5%E9%BB%84%E4%BB%81%E5%8B%8B%E6%96%A5%E8%B4%A3AI%E5%8D%B1%E9%99%A9%E8%AE%BA"}, {"id": 21, "title": "女演员中村友理去世 年仅44岁", "desc": "9月14日，日媒报道称，演员中村友理因直肠癌于9月1日去世，年仅44岁。公告回溯其抗癌经历：13年前她患癌，为不影响工作选择隐瞒，之后康复并定期体检。去年1月癌症复发，手术成功却出现转移；今年8月，她努力复出之际，又突发肠梗阻。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/4eb9bc616078ad917db5ed38f0130e91", "author": "", "timestamp": 0, "hot": 5791321, "url": "https://www.baidu.com/s?wd=%E5%A5%B3%E6%BC%94%E5%91%98%E4%B8%AD%E6%9D%91%E5%8F%8B%E7%90%86%E5%8E%BB%E4%B8%96%20%E5%B9%B4%E4%BB%8544%E5%B2%81", "mobileUrl": "https://www.baidu.com/s?wd=%E5%A5%B3%E6%BC%94%E5%91%98%E4%B8%AD%E6%9D%91%E5%8F%8B%E7%90%86%E5%8E%BB%E4%B8%96+%E5%B9%B4%E4%BB%8544%E5%B2%81"}, {"id": 22, "title": "演唱会求婚 别把没素质当仪式感", "desc": "9月12日，赵雷北京鸟巢演唱会上，前排一名男观众突然向女友求婚，女方激动站起，导致后排齐声高喊“坐下”。此前两人还向周围观众撒喜糖，保安介入制止。演唱会求婚，别把没素质当仪式感。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/8e5c428286064ce4b9215d6ae164fca3", "author": "", "timestamp": 0, "hot": 5700144, "url": "https://www.baidu.com/s?wd=%E6%BC%94%E5%94%B1%E4%BC%9A%E6%B1%82%E5%A9%9A%20%E5%88%AB%E6%8A%8A%E6%B2%A1%E7%B4%A0%E8%B4%A8%E5%BD%93%E4%BB%AA%E5%BC%8F%E6%84%9F", "mobileUrl": "https://www.baidu.com/s?wd=%E6%BC%94%E5%94%B1%E4%BC%9A%E6%B1%82%E5%A9%9A+%E5%88%AB%E6%8A%8A%E6%B2%A1%E7%B4%A0%E8%B4%A8%E5%BD%93%E4%BB%AA%E5%BC%8F%E6%84%9F"}, {"id": 23, "title": "黑龙江三道鳞在上海身价暴涨1斤88元", "desc": "近日，有网友在上海拍到售价88元一斤的东北三道鳞，该价格约为东北老家价格的10倍，引发热议。有媒体报道指出，此高价主要受长途冷链运输成本及当地市场供需关系影响。不少网友打趣称，该鱼走出东北直接升级成了高端水产。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/40a899c13f3816adb8447769c1a7aa60", "author": "", "timestamp": 0, "hot": 5601286, "url": "https://www.baidu.com/s?wd=%E9%BB%91%E9%BE%99%E6%B1%9F%E4%B8%89%E9%81%93%E9%B3%9E%E5%9C%A8%E4%B8%8A%E6%B5%B7%E8%BA%AB%E4%BB%B7%E6%9A%B4%E6%B6%A81%E6%96%A488%E5%85%83", "mobileUrl": "https://www.baidu.com/s?wd=%E9%BB%91%E9%BE%99%E6%B1%9F%E4%B8%89%E9%81%93%E9%B3%9E%E5%9C%A8%E4%B8%8A%E6%B5%B7%E8%BA%AB%E4%BB%B7%E6%9A%B4%E6%B6%A81%E6%96%A488%E5%85%83"}, {"id": 24, "title": "8岁女童被男孩推倒后用电话手表报警", "desc": "近日，上海8岁女童被男孩推倒后用电话手表报警，遭周围大人质疑“小孩子打闹纯属浪费警力”。到场警察蹲下耐心倾听女童讲述，明确表示受到威胁报警是对的，并非浪费警力。随后警察调取监控查明系小男孩推搡。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/ce231081177e6a05e1d59e6e270d3f9a", "author": "", "timestamp": 0, "hot": 5516300, "url": "https://www.baidu.com/s?wd=8%E5%B2%81%E5%A5%B3%E7%AB%A5%E8%A2%AB%E7%94%B7%E5%AD%A9%E6%8E%A8%E5%80%92%E5%90%8E%E7%94%A8%E7%94%B5%E8%AF%9D%E6%89%8B%E8%A1%A8%E6%8A%A5%E8%AD%A6", "mobileUrl": "https://www.baidu.com/s?wd=8%E5%B2%81%E5%A5%B3%E7%AB%A5%E8%A2%AB%E7%94%B7%E5%AD%A9%E6%8E%A8%E5%80%92%E5%90%8E%E7%94%A8%E7%94%B5%E8%AF%9D%E6%89%8B%E8%A1%A8%E6%8A%A5%E8%AD%A6"}, {"id": 25, "title": "拉夫罗夫用华为三折叠", "desc": "近日，在印度新德里举行的金砖国家峰会期间，记者注意到俄罗斯外长拉夫罗夫正在使用华为MateXT三折叠手机。同时，俄罗斯总统普京在出席金砖国家工商论坛时，特地点名中国华为，称“中国的华为是世界级全球科技巨头”。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/c23e3d68bfd252c90dd9eef7c5bcddae", "author": "", "timestamp": 0, "hot": 5431851, "url": "https://www.baidu.com/s?wd=%E6%8B%89%E5%A4%AB%E7%BD%97%E5%A4%AB%E7%94%A8%E5%8D%8E%E4%B8%BA%E4%B8%89%E6%8A%98%E5%8F%A0", "mobileUrl": "https://www.baidu.com/s?wd=%E6%8B%89%E5%A4%AB%E7%BD%97%E5%A4%AB%E7%94%A8%E5%8D%8E%E4%B8%BA%E4%B8%89%E6%8A%98%E5%8F%A0"}, {"id": 26, "title": "95后清华核科技女博士当村支书", "desc": "95后清华核科技博士王帅于今年1月主动报名担任恩施州利川市凉雾乡诸天村第一书记。驻村8个月来，她利用设备拍摄乡村风貌，吸引近百游客避暑并对接农产品采购；还协调接通二组自来水、为盘龙片区安装66盏新路灯。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/1924345dd972c737b42b7b24ad21b2b5", "author": "", "timestamp": 0, "hot": 5334265, "url": "https://www.baidu.com/s?wd=95%E5%90%8E%E6%B8%85%E5%8D%8E%E6%A0%B8%E7%A7%91%E6%8A%80%E5%A5%B3%E5%8D%9A%E5%A3%AB%E5%BD%93%E6%9D%91%E6%94%AF%E4%B9%A6", "mobileUrl": "https://www.baidu.com/s?wd=95%E5%90%8E%E6%B8%85%E5%8D%8E%E6%A0%B8%E7%A7%91%E6%8A%80%E5%A5%B3%E5%8D%9A%E5%A3%AB%E5%BD%93%E6%9D%91%E6%94%AF%E4%B9%A6"}, {"id": 27, "title": "iPhone18Pro直降900 苹果连续3年破发", "desc": "9月14日，iPhone 18 Pro系列预售开启仅两天，某电商平台显示，256G的iPhone 18 Pro售价已经降至9099元，较苹果官网9999元的售价直降900元。iPhone新机已经连续第三年在电商平台出现上市即破发的情况。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/412e9211a7052ff17deec103a780c1c5", "author": "", "timestamp": 0, "hot": 5227996, "url": "https://www.baidu.com/s?wd=iPhone18Pro%E7%9B%B4%E9%99%8D900%20%E8%8B%B9%E6%9E%9C%E8%BF%9E%E7%BB%AD3%E5%B9%B4%E7%A0%B4%E5%8F%91", "mobileUrl": "https://www.baidu.com/s?wd=iPhone18Pro%E7%9B%B4%E9%99%8D900+%E8%8B%B9%E6%9E%9C%E8%BF%9E%E7%BB%AD3%E5%B9%B4%E7%A0%B4%E5%8F%91"}, {"id": 28, "title": "全球最大每周车展创始人车祸身亡", "desc": "当地时间9月13日凌晨，全球规模最大的每周汽车展创始人詹姆斯·韦尔在美国加利福尼亚州发生车祸，其汽车撞树后断成两截并起火燃烧，最终不幸身亡。另一名司机也在事故中遇难，身份尚未公布。", "cover": "https://fyb-2.cdn.bcebos.com/hotboard_image/dca979e8aad1a1f2da0cae0efc729e2c", "author": "", "timestamp": 0, "hot": 5142242, "url": "https://www.baidu.com/s?wd=%E5%85%A8%E7%90%83%E6%9C%80%E5%A4%A7%E6%AF%8F%E5%91%A8%E8%BD%A6%E5%B1%95%E5%88%9B%E5%A7%8B%E4%BA%BA%E8%BD%A6%E7%A5%B8%E8%BA%AB%E4%BA%A1", "mobileUrl": "https://www.baidu.com/s?wd=%E5%85%A